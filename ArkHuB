    local function formatArgs(args)
        local str = ""
        for i, arg in ipairs(args) do
            local typeName = typeof(arg)
            if typeName == "string" then
                str = str .. '"' .. tostring(arg) .. '"'
            elseif typeName == "Instance" then
                str = str .. getWaitForChildPath(arg)
            else
                str = str .. tostring(arg)
            end
            if i < #args then str = str .. ", " end
        end
        return str
    end

    local function logRemote(remote, args, isEvent)
        if BlacklistInstance[remote] or BlacklistName[remote.Name] then return end
        if LoggedRemotes[remote] then return end
        LoggedRemotes[remote] = true

        local logData = {
            Remote = remote,
            Args = args,
            Script = getcallingscript and getcallingscript() or nil,
            IsEvent = isEvent
        }

        table.insert(RemoteLogs, logData)

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 22)
        btn.BackgroundColor3 = CurrentTheme.BTN
        btn.Text = " " .. remote.Name
        btn.TextColor3 = Color3.fromRGB(220, 210, 190)
        btn.Font = VINTAGE_FONT
        btn.TextSize = 10
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = LogsScroll

        btn.MouseButton1Click:Connect(function()
            SelectedRemote = logData
            local remotePath = getWaitForChildPath(logData.Remote)
            local actionMethod = isEvent and ":FireServer(" or ":InvokeServer("
            local code = "-- RemoteSpy Output\n"

            if #args == 0 then
                code = code .. remotePath .. actionMethod .. ")"
            else
                code = code .. "local args = {" .. formatArgs(args) .. "}\n\n"
                code = code .. remotePath .. actionMethod .. "unpack(args))"
            end

            CodeBox.Text = code
        end)
    end

    local rawMetatable = getrawmetatable(game)
    local oldNamecall = rawMetatable.__namecall
    setreadonly(rawMetatable, false)

    rawMetatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if method == "FireServer" or method == "fireServer" then
            logRemote(self, args, true)
        elseif method == "InvokeServer" or method == "invokeServer" then
            logRemote(self, args, false)
        end

        return oldNamecall(self, ...)
    end)

    setreadonly(rawMetatable, true)
end

