    -- Fixed Auto GK Logic: Loop DiveGk first, then immediately Loop Fire + Burst WeldBall
    local function setAutoGkState(state)
        autoGkEnabled = state
        AutoGkIconBtn.Text = autoGkEnabled and "⚽\nON" or "⚽\nOFF"
        AutoGkIconBtn.BackgroundColor3 = autoGkEnabled and THEME.TOGGLE_ON or THEME.PANEL
        AutoGkIconBtn.TextColor3 = autoGkEnabled and Color3.fromRGB(20, 20, 20) or THEME.TEXT

        updateDomeVisual()

        if autoGkEnabled then
            task.spawn(function()
                while autoGkEnabled do
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        updateDomeVisual()

                        for _, obj in ipairs(Workspace:GetChildren()) do
                            if obj.Name == "Ball" and obj:IsA("BasePart") then
                                local ballPos = obj.Position
                                local ballVel = obj.AssemblyLinearVelocity
                                
                                -- Ball Prediction (Triggers slightly before entering range)
                                local predictedPos = ballPos + (ballVel * 0.2)
                                local currentDist = (ballPos - hrp.Position).Magnitude
                                local predictedDist = (predictedPos - hrp.Position).Magnitude

                                if currentDist <= autoGkRange or (predictedDist <= autoGkRange and ballVel.Magnitude > 5) then
                                    local ball = Workspace:FindFirstChild("Ball")
                                    if ball then
                                        local gkEvents = ReplicatedStorage:FindFirstChild("Events")
                                        local gkDive = gkEvents and gkEvents:FindFirstChild("GKDive")
                                        local weldBall = ball:FindFirstChild("WeldBall")

                                        -- 1. Loop fire DiveGk first
                                        for i = 1, 10 do
                                            pcall(function()
                                                if gkDive then
                                                    gkDive:FireServer("Forward")
                                                end
                                            end)
                                        end

                                        -- 2. Immediately loop fire + burst WeldBall
                                        for i = 1, 20 do
                                            pcall(function()
                                                if gkDive then
                                                    gkDive:FireServer("Forward")
                                                end
                                                if weldBall then
                                                    weldBall:FireServer()
                                                end
                                            end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                    task.wait(0.001)
                end
                updateDomeVisual()
            end)
        end
    end

    AutoGkIconBtn.MouseButton1Click:Connect(function()
        local newState = not autoGkEnabled
        setAutoGkState(newState)
        if setMainAutoGkToggleUI then setMainAutoGkToggleUI(newState) end
    end)

