local function loadRemoteSpy()
    local Lighting = getService("Lighting")

    local SelectedRemote = nil
    local RemoteLogs = {}
    local LoggedRemotes = {}
    local BlacklistInstance = {}
    local BlacklistName = {}

    local PRESET_THEMES = {
