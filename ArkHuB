    local iconDragging, iconDragStart, iconStartPos
    StunIconBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            iconDragging = true
            iconDragStart = input.Position
            iconStartPos = StunIconBtn.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if iconDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - iconDragStart
            StunIconBtn.Position = UDim2.new(iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X, iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            iconDragging = false
        end
    end)

    local isStunActive = false
    local setStunToggleUI

    local function triggerStunBurst()
        local char = LocalPlayer.Character
        if not char then return end
        local myHRP = char:FindFirstChild("HumanoidRootPart")
        local myCharPath = getCharacterPath(char)
        if not myHRP or not myCharPath then return end

        for _, targetChar in ipairs(Workspace:GetChildren()) do
            if targetChar:IsA("Model") and targetChar ~= char then
                local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
                local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")

                if targetHum and targetHRP and targetHum.Health > 0 then
                    local dist = (myHRP.Position - targetHRP.Position).Magnitude
                    if dist <= 4 then
                        for i = 1, 20 do
                            pcall(function()
                                local args = {
                                    myCharPath:FindFirstChild("HumanoidRootPart"),
                                    targetChar,
                                    0,
                                    0
                                }
                                ReplicatedStorage:WaitForChild("Characters"):WaitForChild("Combat"):WaitForChild("Remotes"):WaitForChild("KnockbackPush"):FireServer(unpack(args))
                            end)
                        end
                    end
                end
            end
        end
    end

    local function toggleStunHelper(state)
        isStunActive = state
        StunIconBtn.Text = isStunActive and "⚡\nON" or "⚡\nOFF"
        StunIconBtn.BackgroundColor3 = isStunActive and THEME.TOGGLE_ON or THEME.PANEL
        StunIconBtn.TextColor3 = isStunActive and Color3.fromRGB(20, 20, 20) or THEME.TEXT

        if isStunActive then
            task.spawn(function()
                while isStunActive do
                    triggerStunBurst()
                    task.wait(0.01)
                end
            end)
        end
    end

    StunIconBtn.MouseButton1Click:Connect(function()
        local newState = not isStunActive
        toggleStunHelper(newState)
        if setStunToggleUI then setStunToggleUI(newState) end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == stunHelperKeybind and stunHelperEnabled then
            local newState = not isStunActive
            toggleStunHelper(newState)
            if setStunToggleUI then setStunToggleUI(newState) end
        end
    end)

    local _, setMainStunToggle = createToggleRow(CombatPage, "Stun Helper (Toggle):", function(state)
        stunHelperEnabled = state
        StunIconBtn.Visible = state
        if not state then
            toggleStunHelper(false)
        end
    end)
    setStunToggleUI = setMainStunToggle

    local KeybindRow = Instance.new("Frame")
    KeybindRow.Size = UDim2.new(0.92, 0, 0, 28)
