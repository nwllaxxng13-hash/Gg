local function resolvePath(pathStr)
    pathStr = pathStr:gsub("^%s+", ""):gsub("%s+$", "")
    local obj = game
    for part in string.gmatch(pathStr, "[^%s%.]+") do
        if part ~= "game" then
            if obj then
                obj = obj:FindFirstChild(part)
            else
                return nil
            end
        end
    end
    return obj
end

CopyButton.MouseButton1Click:Connect(function()
    local pathText = TextBox.Text
    local target = resolvePath(pathText)
    
    if target then
        if target:IsA("ModuleScript") or target:IsA("LocalScript") or target:IsA("Script") then
            local success, sourceCode = pcall(function()
                return target.Source
            end)
            
            if success and sourceCode and sourceCode ~= "" then
                if setclipboard then
                    setclipboard(sourceCode)
                    CopyButton.Text = "Copied to Clipboard!"
                else
                    CopyButton.Text = "setclipboard not supported!"
                end
            else
                CopyButton.Text = "Source empty or restricted!"
            end
        else
            CopyButton.Text = "Not a Script/Module!"
        end
    else
        CopyButton.Text = "Path not found!"
    end
    
    task.delay(2, function()
        CopyButton.Text = "Start Copy"
    end)
end)
