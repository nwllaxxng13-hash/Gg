end

local function TweenToTarget(hrp, targetCFrame, targetPlayer, isAlt)
    local lastRef = isAlt and AltV5LastTweenTarget or V5LastTweenTarget
    if lastRef == targetPlayer and currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
        return
    end
    if currentTween then pcall(function() currentTween:Cancel() end) end
    if isAlt then AltV5LastTweenTarget = targetPlayer else V5LastTweenTarget = targetPlayer end
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 220
    local timeToReach = math.clamp(dist / speed, 0.12, 0.75)
    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()
end

