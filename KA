-- ==========================================
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if method == "FireServer" and not checkcaller() then
        local selfName = tostring(self):lower()
        if selfName:match("ban") or selfName:match("kick") or selfName:match("report") or selfName:match("anticheat") or selfName:match("ac") then
            return nil
        end
    end
    return oldNamecall(self, unpack(args))
end)

mt.__index = newcclosure(function(self, key)
    if not checkcaller() then
        if key == "WalkSpeed" or key == "Speed" then return 16 end
        if key == "JumpPower" then return 50 end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

