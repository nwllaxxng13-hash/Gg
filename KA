task.spawn(function()
    while true do
        task.wait(0.08)
        if not FarmingV5Enabled then continue end

        local myChar = L.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then continue end

        if not IsTargetValid(CurrentTarget) or (tick() - LastTargetSwitch > TargetLockTime) then
            CurrentTarget = GetNearestPlayerV4()
            if CurrentTarget then LastTargetSwitch = tick() end
        end

        if CurrentTarget and IsTargetValid(CurrentTarget) then
            local targetHRP = CurrentTarget.Character.HumanoidRootPart
            local dist = (targetHRP.Position - myHRP.Position).Magnitude

            if dist > 8 then
                TweenToTarget(myHRP, targetHRP.CFrame)
            else
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 4, -6)
            end

            for skill, enabled in pairs(SelectedSkills) do
                if enabled then
                    pcall(function() CombatRemote:FireServer("UseSkill", skill) end)
                end
            end
        end
    end
end)

