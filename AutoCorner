-- 2. ระบบสร้าง Part แสดงจุด Visualizer (Neon Parts)
----------------------------------------------------------------
local VisualFolder = Workspace:FindFirstChild("CornerVisuals") or Instance.new("Folder")
VisualFolder.Name = "CornerVisuals"
VisualFolder.Parent = Workspace

local function CreateVisualPart(name)
    local part = VisualFolder:FindFirstChild(name) or Instance.new("Part")
    part.Name = name
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(3, 3, 3)
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(255, 255, 255)
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 0.2
    part.Parent = VisualFolder
    return part
end

local VisualLeft = CreateVisualPart("Visual_Left")
local VisualRight = CreateVisualPart("Visual_Right")

local function UpdateVisualizerPositions()
    local currentSet = Sets[CurrentSetKey]
    VisualLeft.Position = currentSet.Left
    VisualRight.Position = currentSet.Right
end

UpdateVisualizerPositions()

