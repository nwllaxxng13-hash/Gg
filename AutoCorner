----------------------------------------------------------------
-- 4. Smart Lock Raycast & Collision Engine
----------------------------------------------------------------
local function IsPathBlockedByEnemy(originPos, targetPos)
    local direction = targetPos - originPos
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = RaycastFilterType.Exclude

    -- กรองตัวละครผู้เล่นฝั่งตัวเองออก
    local ignoreList = {LocalPlayer.Character, VisualFolder}
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or (LocalPlayer.Team and player.Team == LocalPlayer.Team) then
            if player.Character then
                table.insert(ignoreList, player.Character)
            end
        end
    end
    raycastParams.FilterDescendantsInstances = ignoreList

    local rayResult = Workspace:Raycast(originPos, direction, raycastParams)
    
    if rayResult and rayResult.Instance then
        local hitChar = rayResult.Instance:FindFirstAncestorOfClass("Model")
        if hitChar and Players:GetPlayerFromCharacter(hitChar) then
            return true -- พบศัตรูขวางเส้นทาง
        end
    end
    
    return false
end

local function GetSmartTargetCorner()
    local camCFrame = Camera.CFrame
    local camPos = camCFrame.Position
    local camLook = camCFrame.LookVector
    local currentSet = Sets[CurrentSetKey]

    local dirLeft = (currentSet.Left - camPos).Unit
    local dirRight = (currentSet.Right - camPos).Unit

    local dotLeft = camLook:Dot(dirLeft)
    local dotRight = camLook:Dot(dirRight)

    -- คำนวณฝั่งหลักตามทิศทางกล้อง
    local primaryIsLeft = dotLeft > dotRight
    local charPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or camPos

    if SmartLockEnabled then
        local leftBlocked = IsPathBlockedByEnemy(charPos, currentSet.Left)
        local rightBlocked = IsPathBlockedByEnemy(charPos, currentSet.Right)

        -- กรณีถูกบังแค่ฝั่งเดียว ให้หลบไปอีกฝั่ง
        if leftBlocked and not rightBlocked then
            VisualLeft.Color = Color3.fromRGB(255, 255, 255)
            VisualRight.Color = Color3.fromRGB(255, 0, 0)
            return currentSet.Right
        elseif rightBlocked and not leftBlocked then
            VisualLeft.Color = Color3.fromRGB(255, 0, 0)
            VisualRight.Color = Color3.fromRGB(255, 255, 255)
            return currentSet.Left
        end
        -- กรณีโดนบังทั้งคู่ หรือไม่โดนบังเลย ให้ใช้ทิศทางตามกล้อง
    end

    -- Default Camera Lock
    if primaryIsLeft then
        VisualLeft.Color = Color3.fromRGB(255, 0, 0)
        VisualRight.Color = Color3.fromRGB(255, 255, 255)
        return currentSet.Left
    else
        VisualLeft.Color = Color3.fromRGB(255, 255, 255)
        VisualRight.Color = Color3.fromRGB(255, 0, 0)
        return currentSet.Right
    end
end

----------------------------------------------------------------
-- 5. Execution Loop
----------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local targetCorner = GetSmartTargetCorner()

    if not AutoCornerEnabled then return end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    local state = humanoid:GetState()
    local isJumping = (state == Enum.HumanoidStateType.Jumping) or 
                      (state == Enum.HumanoidStateType.Freefall) or 
                      (root.Velocity.Y > 0.5)

    if isJumping then
        root.CFrame = CFrame.new(root.Position, Vector3.new(targetCorner.X, root.Position.Y, targetCorner.Z))
    end
end)
