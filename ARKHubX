local function autoScale()
    if Config.Scale and Config.Scale ~= 1.0 then return Config.Scale end
    local cam = getCam(); if not cam then return 1.0 end
    local w = cam.ViewportSize.X
    if w >= 1100 then return 1.0
    elseif w >= 800 then return 0.85
    elseif w >= 600 then return 0.75
    else return 0.62 end
end

local NotifyScale = Instance.new("UIScale", NotifyHolder)
NotifyScale.Scale = autoScale()

local function notify(text, color, dur)
    color = color or Color3.fromRGB(80,255,120); dur = dur or 1.6
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(.5,.5); f.Position = UDim2.fromScale(.5,.3)
    f.Size = UDim2.fromOffset(280,44); f.BackgroundColor3 = Color3.fromRGB(15,15,22)
    f.BackgroundTransparency = 1; f.BorderSizePixel = 0; f.Parent = NotifyHolder
    Instance.new("UICorner", f).CornerRadius = UDim.new(0,12)
    local s = Instance.new("UIStroke", f); s.Color = color; s.Thickness = 2.2; s.Transparency = 1; s.Parent = f
    local l = Instance.new("TextLabel", f); l.Size = UDim2.fromScale(1,1); l.BackgroundTransparency = 1
    l.Text = text; l.TextColor3 = color; l.TextScaled = true; l.Font = FONT_TITLE; l.TextTransparency = 1
    TS:Create(f, TweenInfo.new(.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundTransparency = .12, Size = UDim2.fromOffset(360,62) }):Play()
    TS:Create(s, TweenInfo.new(.25), { Transparency = 0 }):Play()
    TS:Create(l, TweenInfo.new(.25), { TextTransparency = 0 }):Play()
    task.delay(dur, function()
        TS:Create(f, TweenInfo.new(.35), { BackgroundTransparency = 1, Size = UDim2.fromOffset(300,48) }):Play()
        TS:Create(s, TweenInfo.new(.4), { Transparency = 1 }):Play()
        TS:Create(l, TweenInfo.new(.4), { TextTransparency = 1 }):Play()
        task.wait(.45); f:Destroy()
    end)
end

