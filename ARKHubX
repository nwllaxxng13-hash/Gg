    local gettingGun = false
    local function giveGun(toolName)
        if gettingGun then return end
        gettingGun = true
        local ch = LP.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if not (ch and root) then gettingGun = false; return end
        if ch:FindFirstChild("ForceField") then gettingGun = false; return end
        if (LP.Backpack and LP.Backpack:FindFirstChild(toolName)) or ch:FindFirstChild(toolName) then gettingGun = false; return end
        local giver
        for _, v in ipairs(WSvc:GetDescendants()) do
            if v.Name == "TouchGiver" and v:GetAttribute("ToolName") == toolName then
                giver = v:FindFirstChildWhichIsA("BasePart"); if giver then break end
            end
        end
        if not giver then gettingGun = false; return end
        local orig = giver.CFrame
        local oldC = root.CFrame
        local under = orig - Vector3.new(0, 15.5, 0)
        giver.CanTouch = true
        giver.CFrame = under
        ch:PivotTo(under + Vector3.new(0,5,0))
        task.wait(0.25)
        firetouchinterest(giver, root, 0)
        task.wait(0.3)
        firetouchinterest(giver, root, 1)
        task.wait(0.05)
        giver.CFrame = orig
        ch:PivotTo(oldC)
        task.wait(0.1)
        gettingGun = false
    end
