local function syncStatesToCfg()
    Config.VL = {}
    for k in pairs(VL_KEYS) do if VLState[k] ~= nil then Config.VL[k] = VLState[k] end end
    Config.NF = {}
    for k in pairs(NF_KEYS) do if NFState[k] ~= nil then Config.NF[k] = NFState[k] end end
    Config.FF = {}
    for k in pairs(FF_KEYS) do if FFState[k] ~= nil then Config.FF[k] = FFState[k] end end
    Config.PL = {}
    for k in pairs(PL_KEYS) do if PLState[k] ~= nil then Config.PL[k] = PLState[k] end end
    -- arrays
    for k in pairs(PL_ARRAYS) do
        if type(PLState[k]) == "table" then
            Config.PL[k] = {}
            for kk, vv in pairs(PLState[k]) do Config.PL[k][kk] = vv end
        end
    end
    -- Color3s (serialize manually)
    local function col(c) return {c.R, c.G, c.B} end
    Config.PL.GunColor = col(PLState.GunColor)
    Config.PL.BulletColor = col(PLState.BulletColor)
    Config.PL.BulletHlColor = col(PLState.BulletHlColor)
    Config.PL.BulletHlOutline = col(PLState.BulletHlOutline)
    Config.PL.TracerOutline = col(PLState.TracerOutline)
    Config.PL.TracerInline = col(PLState.TracerInline)
    Config.PL.FogColor = col(PLState.FogColor)
end

local function loadStatesFromCfg()
    if type(Config.VL) == "table" then
        for k, v in pairs(Config.VL) do if VL_KEYS[k] then VLState[k] = v end end
    end
    if type(Config.NF) == "table" then
        for k, v in pairs(Config.NF) do if NF_KEYS[k] then NFState[k] = v end end
    end
    if type(Config.FF) == "table" then
        for k, v in pairs(Config.FF) do if FF_KEYS[k] then FFState[k] = v end end
    end
    if type(Config.PL) == "table" then
        for k, v in pairs(Config.PL) do
            if PL_KEYS[k] then PLState[k] = v
            elseif PL_ARRAYS[k] and type(v) == "table" then
                PLState[k] = {}
                for kk, vv in pairs(v) do PLState[k][kk] = vv end
            end
        end
        local function uc(t) if type(t) == "table" and #t == 3 then return Color3.new(t[1],t[2],t[3]) end end
        PLState.GunColor = uc(Config.PL.GunColor) or PLState.GunColor
        PLState.BulletColor = uc(Config.PL.BulletColor) or PLState.BulletColor
        PLState.BulletHlColor = uc(Config.PL.BulletHlColor) or PLState.BulletHlColor
        PLState.BulletHlOutline = uc(Config.PL.BulletHlOutline) or PLState.BulletHlOutline
        PLState.TracerOutline = uc(Config.PL.TracerOutline) or PLState.TracerOutline
        PLState.TracerInline = uc(Config.PL.TracerInline) or PLState.TracerInline
        PLState.FogColor = uc(Config.PL.FogColor) or PLState.FogColor
    end
end

local savePending, saveScheduled = false, false
local function saveCfgNow()
    if not HAS_FS then return false end
    syncStatesToCfg()
    local ok, enc = pcall(function() return Http:JSONEncode(Config) end)
    if ok and enc then return (pcall(writefile, CONFIG_FILE, enc)) end
    return false
end
local function saveCfg() return saveCfgNow() end
local function saveCfgDebounced()
    savePending = true
    if saveScheduled then return end
    saveScheduled = true
    task.delay(0.5, function()
        saveScheduled = false
        if savePending then savePending = false; saveCfgNow() end
    end)
end
local function loadCfg()
    if not HAS_FS then return end
    local ok, data = pcall(readfile, CONFIG_FILE)
    if not ok or not data or data == "" then return end
    local ok2, d = pcall(function() return Http:JSONDecode(data) end)
    if ok2 and type(d) == "table" then
        for k, v in pairs(d) do if Config[k] ~= nil then Config[k] = v end end
    end
end
loadCfg()
loadStatesFromCfg()

local function loadJSON(p, d)
    if not HAS_FS then return d end
    local ok, data = pcall(readfile, p)
    if not ok or not data or data == "" then return d end
    local ok2, v = pcall(function() return Http:JSONDecode(data) end)
    if ok2 and type(v) == "table" then return v end
    return d
end
local function saveJSON(p, d)
    if not HAS_FS then return false end
    local ok, enc = pcall(function() return Http:JSONEncode(d) end)
    if ok and enc then pcall(writefile, p, enc); return true end
    return false
end
local function loadSug() return loadJSON(SUG_FILE, {}) end
local function saveSug(l) return saveJSON(SUG_FILE, l) end
local function loadBans() return loadJSON(BAN_FILE, {}) end
local function saveBans(b) return saveJSON(BAN_FILE, b) end
local function addSug(t)
    local l = loadSug()
    table.insert(l, { from = LP.Name, display = LP.DisplayName, text = t, time = os.time(), game = Config.Game or "?" })
    saveSug(l)
end
local function delSug(i) local l = loadSug(); if l[i] then table.remove(l, i); saveSug(l); return true end return false end
local function addBan(n, m) local b = loadBans(); b[n] = { expiresAt = os.time() + m*60, minutes = m, by = LP.Name }; saveBans(b) end
local function delBan(n) local b = loadBans(); b[n] = nil; saveBans(b) end

local banInfo = loadBans()[LP.Name]
if banInfo and banInfo.expiresAt and os.time() < banInfo.expiresAt then
    local mins = math.max(1, math.ceil((banInfo.expiresAt - os.time())/60))
    pcall(function() LP:Kick("Banned from Ark Hub for "..mins.." min") end)
    local bg = Instance.new("ScreenGui", PG); bg.IgnoreGuiInset = true; bg.DisplayOrder = 99999
    local f = Instance.new("Frame", bg); f.Size = UDim2.fromScale(1,1); f.BackgroundColor3 = Color3.fromRGB(10,5,15)
    local t1 = Instance.new("TextLabel", f); t1.Size = UDim2.new(1,0,0,60); t1.Position = UDim2.fromScale(0,.42); t1.BackgroundTransparency = 1
    t1.Font = FONT_TITLE; t1.TextSize = 34; t1.TextColor3 = Color3.fromRGB(255,80,80); t1.Text = "YOU ARE BANNED"
    local t2 = Instance.new("TextLabel", f); t2.Size = UDim2.new(1,0,0,40); t2.Position = UDim2.fromScale(0,.52); t2.BackgroundTransparency = 1
    t2.Font = FONT_BODY; t2.TextSize = 20; t2.TextColor3 = Color3.fromRGB(230,200,200); t2.Text = "Banned for "..mins.." minutes"
    return
end

