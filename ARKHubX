    local function getFacingTarget()
        if not VLState.Court.Valid then return nil, false end
        local L, R = VLState.Court.LT, VLState.Court.RT
        if not L or not R then return nil, false end
        local ch = LP.Character; local cam = getCam()
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local mp = hrp and hrp.Position or (cam and cam.CFrame.Position)
        if not mp then return nil, false end
        local lk = cam and cam.CFrame.LookVector or Vector3.new(0,0,-1)
        local dL = lk:Dot((L-mp).Unit); local dR = lk:Dot((R-mp).Unit)
        local normalTarget = (dL >= dR) and L or R
        if not VLState.SmartLock then VS.Position = Vector3.new(0,-500,0); return normalTarget, false end
        if not isOnOC(mp) then VS.Position = Vector3.new(0,-500,0); return normalTarget, false end
        local n = tick()
        if not VLState.SafeCache.pos or (n - VLState.SafeCache.time) > 0.1 then
            local safe = computeSafe()
            if safe then VLState.SafeCache.pos = safe; VLState.SafeCache.time = n end
        end
        if VLState.SafeCache.pos then VS.Position = VLState.SafeCache.pos; return VLState.SafeCache.pos, true end
        local lB = isBlocked(mp, L); local rB = isBlocked(mp, R)
        if lB and not rB then return R, false end
        if rB and not lB then return L, false end
        return normalTarget, false
    end
