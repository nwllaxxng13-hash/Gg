local function buildVL()
    local VF = Workspace:FindFirstChild("CornerVisuals") or Instance.new("Folder", Workspace)
    VF.Name = "CornerVisuals"
    local function mk(n,c) local p = VF:FindFirstChild(n) if not p then p = Instance.new("Part", VF) p.Name = n p.Shape = Enum.PartType.Ball p.Size = Vector3.new(3,3,3) p.Material = Enum.Material.Neon p.Anchored = true p.CanCollide = false p.CanQuery = false p.CanTouch = false p.Transparency = .2 end p.Color = c p.Position = Vector3.new(0,-500,0) return p end
    local VL = mk("Visual_Left", Color3.fromRGB(255,255,255))
    local VR = mk("Visual_Right", Color3.fromRGB(255,255,255))
    local VT = mk("Visual_Target", Color3.fromRGB(255,0,0))
    local VS = mk("Visual_Safe", Color3.fromRGB(0,200,255))
    VS.Transparency = .4; VS.Size = Vector3.new(4,4,4)

    local tabC = makeTab("tab_vl_corner", 1)
    local tabH = makeTab("tab_vl_hitbox", 2)
    local tabE = makeTab("tab_vl_esp", 3)

    local function findCourt()
        local m = Workspace:FindFirstChild("Map")
        if m and m:FindFirstChild("Court") then return m.Court end
        local c = Workspace:FindFirstChild("Court"); if c then return c end
    end
    local function findOC()
        local m = Workspace:FindFirstChild("Map")
        if m and m:FindFirstChild("OuterCourt") then return m.OuterCourt end
        return Workspace:FindFirstChild("OuterCourt")
    end
    local function collectParts(c)
        local p = {}; if not c then return p end
        if c:IsA("BasePart") then table.insert(p, c) end
        for _, d in ipairs(c:GetDescendants()) do if d:IsA("BasePart") then table.insert(p, d) end end
        return p
    end
    local function getBounds(ps)
        if #ps == 0 then return nil end
        local mn = Vector3.new(math.huge, math.huge, math.huge); local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, p in ipairs(ps) do local po, h = p.Position, p.Size*.5
            mn = Vector3.new(math.min(mn.X,po.X-h.X), math.min(mn.Y,po.Y-h.Y), math.min(mn.Z,po.Z-h.Z))
            mx = Vector3.new(math.max(mx.X,po.X+h.X), math.max(mx.Y,po.Y+h.Y), math.max(mx.Z,po.Z+h.Z))
        end
        return mn, mx, (mn+mx)*.5
    end
    local function autoCheckCourt()
        local c = findCourt(); if not c then return false, "Court not found" end
        local ps = collectParts(c); if #ps == 0 then return false, "No BasePart" end
        local mn, mx, ce = getBounds(ps)
        local mp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart.Position
        if not mp then local cam = getCam(); mp = cam and cam.CFrame.Position or ce end
        local sx, sz = mx.X-mn.X, mx.Z-mn.Z
        local ax = (sx>sz) and "X" or "Z"
        local av = function(v) return ax=="X" and v.X or v.Z end
        local sg = (av(mp) >= av(ce)) and 1 or -1
        local y = ce.Y
        local oa = (sg==1) and mn or mx
        local L, R
        if ax == "X" then L = Vector3.new(oa.X, y, mn.Z); R = Vector3.new(oa.X, y, mx.Z)
        else L = Vector3.new(mn.X, y, oa.Z); R = Vector3.new(mx.X, y, oa.Z) end
        local fw = Vector3.new(ce.X-mp.X, 0, ce.Z-mp.Z)
        if fw.Magnitude < .01 then fw = Vector3.new(0,0,1) end
        fw = fw.Unit
        local rd = fw:Cross(Vector3.new(0,1,0))
        if rd.Magnitude < .01 then rd = Vector3.new(1,0,0) end
        rd = rd.Unit
        local a = Vector3.new(L.X-mp.X, 0, L.Z-mp.Z)
        local b = Vector3.new(R.X-mp.X, 0, R.Z-mp.Z)
        if a:Dot(rd) > b:Dot(rd) then L, R = R, L end
        VLState.Court.Valid = true
        VLState.Court.Center = ce
        VLState.Court.MinV = mn; VLState.Court.MaxV = mx
        VLState.Court.LT = L; VLState.Court.RT = R
        VLState.Court.OP = collectParts(findOC())
        VLState.Court.Sign = sg; VLState.Court.Axis = ax
        VL.Position = L; VR.Position = R; VL.Color = Color3.new(1,1,1); VR.Color = Color3.new(1,1,1)
        return true
    end
    local function isOnOC(pos)
        for _, p in ipairs(VLState.Court.OP) do
            local lp = p.CFrame:PointToObjectSpace(pos); local h = p.Size*.5
            if math.abs(lp.X) <= h.X+2 and math.abs(lp.Z) <= h.Z+2 then return true end
        end
        return false
    end
    local function computeSafe()
        if not VLState.Court.Valid then return nil end
        local mn, mx, ce = VLState.Court.MinV, VLState.Court.MaxV, VLState.Court.Center
        local ax, sg = VLState.Court.Axis, VLState.Court.Sign
        local os = -sg; local y = ce.Y
        local av = function(v) return ax=="X" and v.X or v.Z end
        local oM, oX
        if os == 1 then oM = av(ce); oX = av(mx) else oM = av(mn); oX = av(ce) end
        local en = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character and not (LP.Team and plr.Team == LP.Team) then
                local h = plr.Character:FindFirstChild("HumanoidRootPart")
                local hu = plr.Character:FindFirstChildOfClass("Humanoid")
                if h and hu and hu.Health > 0 then table.insert(en, h.Position) end
            end
        end
        local best, bs = nil, -math.huge
        for i = 1,5 do local ta = .25 + (i-1)/4*.55
            for j = 1,5 do local tb = .1 + (j-1)/4*.8
                local aC = oM + (oX-oM)*ta
                local p
                if ax == "X" then p = Vector3.new(aC, y, mn.Z + (mx.Z-mn.Z)*tb)
                else p = Vector3.new(mn.X + (mx.X-mn.X)*tb, y, aC) end
                if p.X >= mn.X and p.X <= mx.X and p.Z >= mn.Z and p.Z <= mx.Z then
                    local sc
                    if #en == 0 then sc = -(Vector3.new(p.X,0,p.Z)-Vector3.new(ce.X,0,ce.Z)).Magnitude
                    else sc = math.huge for _, e in ipairs(en) do local d = (Vector3.new(e.X,0,e.Z)-Vector3.new(p.X,0,p.Z)).Magnitude if d < sc then sc = d end end end
                    if sc > bs then bs = sc; best = p end
                end
            end
        end
        return best
    end
    local function isBlocked(o, tp)
        local p = RaycastParams.new(); p.FilterType = Enum.RaycastFilterType.Exclude
        local ig = {LP.Character, VF}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LP or (LP.Team and plr.Team == LP.Team) then
                if plr.Character then table.insert(ig, plr.Character) end
            end
        end
        p.FilterDescendantsInstances = ig
        local r = Workspace:Raycast(o, tp-o, p)
        if r and r.Instance then
            local c = r.Instance:FindFirstAncestorOfClass("Model")
            if c and Players:GetPlayerFromCharacter(c) then return true end
        end
        return false
    end
    local function getFacingTarget()
        if not VLState.Court.Valid then return nil, false end
        local L, R = VLState.Court.LT, VLState.Court.RT
        if not L or not R then return nil, false end
        local ch = LP.Character; local cam = getCam()
        local mp = (ch and ch:FindFirstChild("HumanoidRootPart")) and ch.HumanoidRootPart.Position or (cam and cam.CFrame.Position)
        if not mp then return nil, false end
        local lk = cam and cam.CFrame.LookVector or Vector3.new(0,0,-1)
        if VLState.SmartLock and isOnOC(mp) then
            local n = tick()
            if not VLState.SafeCache.pos or (n - VLState.SafeCache.time) > .15 then
                VLState.SafeCache.pos = computeSafe() or VLState.SafeCache.pos
                VLState.SafeCache.time = n
            end
            if VLState.SafeCache.pos then VS.Position = VLState.SafeCache.pos; return VLState.SafeCache.pos, true end
        else VS.Position = Vector3.new(0,-500,0) end
        local dL = lk:Dot((L-mp).Unit)
        local dR = lk:Dot((R-mp).Unit)
        local tg = (dL >= dR) and L or R
        if VLState.SmartLock then
            local lB = isBlocked(mp, L); local rB = isBlocked(mp, R)
            if lB and not rB then return R, false end
            if rB and not lB then return L, false end
        end
        return tg, false
    end
