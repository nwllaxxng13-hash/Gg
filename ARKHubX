    mkBtn("nf_name", "nf_desc", 2, "NF")
    mkBtn("ff_name", "ff_desc", 3, "FF")
    mkBtn("pl_name", "pl_desc", 4, "PL")
    TS:Create(bg, TweenInfo.new(.4), { BackgroundTransparency = .05 }):Play()
