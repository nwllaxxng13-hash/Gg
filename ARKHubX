                Instance.new("UICorner", r).CornerRadius = UDim.new(0,8)
                local nml = newLabel(r, UDim2.fromOffset(10,4), UDim2.new(.6,-10,0,20), nm, FONT_BOLD, fs(13))
                nml.TextColor3 = Color3.fromRGB(255,200,200)
                local rem = (info.expiresAt or 0) - os.time()
                local rt = rem > 0 and t("ban_left", math.max(1, math.ceil(rem/60))) or "expired"
                local tl = newLabel(r, UDim2.fromOffset(10,24), UDim2.new(.6,-10,0,18), rt, FONT_BODY, fs(11))
                tl.TextColor3 = Color3.fromRGB(220,180,180)
                local ub = newButton(r, t("ban_unban"), 36, function()
                    delBan(nm); notify(t("ban_removed", nm), Color3.fromRGB(120,220,255), 1.8); refreshBans()
                end, 1)
                ub.AnchorPoint = Vector2.new(1,.5); ub.Position = UDim2.new(1,-8,.5,0)
                ub.Size = UDim2.fromOffset(90,32)
            end
        end
        refreshBans()

        task.spawn(function()
            local init = #loadSug()
            if Config.LastSeenSug == 0 then Config.LastSeenSug = init; saveCfg() end
            while task.wait(1.5) do
                local cur = #loadSug()
                local last = Config.LastSeenSug or 0
                if cur > last then
                    refreshInbox()
                    if ActiveTab ~= "tab_admin" then
                        setBadge("tab_admin", true)
                        notify(t("suggest_new", cur - last), Color3.fromRGB(80,200,255), 2)
                    else
                        Config.LastSeenSug = cur; saveCfg()
                    end
                elseif cur < last then
                    Config.LastSeenSug = cur; saveCfg(); refreshInbox()
                end
            end
        end)
    end
end

