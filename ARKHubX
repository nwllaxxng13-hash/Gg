    local function isFriend(uid)
        if Friends[uid] ~= nil then return Friends[uid] end
        local ok, r = pcall(function() return LP:IsFriendsWith(uid) end)
        Friends[uid] = ok and r or false
        return Friends[uid]
    end
    local function teamIsIgnored(plr, ignoreTbl)
        if not plr.Team then return false end
        return ignoreTbl[plr.Team.Name] == true
    end
    local function flagIsIgnored(plr, ignoreFlags)
        local ch = plr.Character
        if not ch then return false end
        if ignoreFlags.ForceField and ch:FindFirstChild("ForceField") then return true end
        if ignoreFlags.Hostile and ch:GetAttribute("Hostile") == true then return true end
        if ignoreFlags.Trespassing and ch:GetAttribute("Trespassing") == true then return true end
        if ignoreFlags.Friends and isFriend(plr.UserId) then return true end
        return false
    end
    local function enemyPass(plr, ignoreTbl, ignoreFlags)
        if plr == LP then return false end
        if ignoreTbl and teamIsIgnored(plr, ignoreTbl) then return false end
        if ignoreFlags and flagIsIgnored(plr, ignoreFlags) then return false end
