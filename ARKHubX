local FFState = {
    Reach = 15, Thickness = 20, YOffset = 2,
    MagsEnabled = false, BubbleEnabled = false, BubbleRadius = 15,
    TargetingEnabled = true, TeammateOnly = true, CameraLockEnabled = false,
    TargetRange = 250, ThrowPower = 85, LeadMultiplier = 1.0,
    AssistMode = "Precision", ShowTrajectory = true, ShowDebug = true,
    TrajectoryColor = Color3.fromRGB(0, 255, 128),
    FakeArms = {},
    CurrentTarget = nil, ManualTarget = nil,
    IsThrowing = false,
    TrajectoryLines = {}, CatchMarker = nil,
    VisualBubble = nil,
    DebugText = nil, DebugUI = nil,
    UpdateThrottle = 0,
}

local function buildFF()
    local Gravity = Workspace.Gravity
