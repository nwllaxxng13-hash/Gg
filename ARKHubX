    local list = Instance.new("Frame", container)
    list.Position = UDim2.fromOffset(0, 48); list.Size = UDim2.new(1, 0, 0, 0)
    list.AutomaticSize = Enum.AutomaticSize.Y; list.BackgroundTransparency = 1
    local layout = Instance.new("UIListLayout", list); layout.Padding = UDim.new(0,8); layout.SortOrder = Enum.SortOrder.LayoutOrder
    local buttons = {}; local clicked = false
    local function mkBtn(nameKey, descKey, ord, gameId)
        local btn = Instance.new("TextButton", list)
        btn.Size = UDim2.new(1,0,0,72); btn.LayoutOrder = ord
        btn.BackgroundColor3 = Color3.fromRGB(22,20,36); btn.BackgroundTransparency = 1
        btn.Text = ""; btn.BorderSizePixel = 0; btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0,12)
        local bs = Instance.new("UIStroke", btn); bs.Color = Themes[Config.Theme].base; bs.Thickness = 1.5; bs.Transparency = 1
        regA(bs, "Color")
        local nm = newLabel(btn, UDim2.fromOffset(16,10), UDim2.new(1,-32,0,24), t(nameKey), FONT_TITLE, 16)
        nm.TextColor3 = Color3.fromRGB(255,255,255); nm.TextTransparency = 1
        local ds = newLabel(btn, UDim2.fromOffset(16,38), UDim2.new(1,-32,0,22), t(descKey), FONT_BODY, 11)
        ds.TextColor3 = Color3.fromRGB(190,180,220); ds.TextTransparency = 1
        TS:Create(btn, TweenInfo.new(.4), { BackgroundTransparency = .12 }):Play()
        TS:Create(bs, TweenInfo.new(.4), { Transparency = .25 }):Play()
        TS:Create(nm, TweenInfo.new(.5), { TextTransparency = 0 }):Play()
        TS:Create(ds, TweenInfo.new(.5), { TextTransparency = 0 }):Play()
        btn.MouseEnter:Connect(function() TS:Create(btn, TweenInfo.new(.2, Enum.EasingStyle.Back), { Size = UDim2.new(1,12,0,78) }):Play(); TS:Create(bs, TweenInfo.new(.2), { Transparency = 0 }):Play() end)
        btn.MouseLeave:Connect(function() TS:Create(btn, TweenInfo.new(.2), { Size = UDim2.new(1,0,0,72) }):Play(); TS:Create(bs, TweenInfo.new(.2), { Transparency = .25 }):Play() end)
        btn.MouseButton1Click:Connect(function()
            if clicked then return end
            clicked = true
            Config.Game = gameId; saveCfg()
            local fade = TweenInfo.new(.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TS:Create(bg, fade, { BackgroundTransparency = 1 }):Play()
            TS:Create(container, fade, { BackgroundTransparency = 1 }):Play()
            TS:Create(title, fade, { TextTransparency = 1 }):Play()
            for _, b in ipairs(buttons) do TS:Create(b, fade, { BackgroundTransparency = 1, TextTransparency = 1 }):Play() end
            if onSelect then onSelect(gameId) end
            task.delay(.25, function() if l then l:Destroy() end end)
        end)
        table.insert(buttons, btn); table.insert(buttons, nm); table.insert(buttons, ds)
    end
