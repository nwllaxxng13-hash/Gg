                TS:Create(b, fadeTween, { BackgroundTransparency = 1 }):Play()
            end

            -- Boot immediately (don't wait)
            if onSelect then onSelect(gameId) end

            -- Destroy screen after fade
            task.delay(.25, function()
                if l then l:Destroy() end
            end)
        end)
        table.insert(buttons, btn)
        -- Track sublabels for fade
        table.insert(buttons, nm)
        table.insert(buttons, ds)
        return btn
    end

    makeGameBtn("vl_name", "vl_desc", 1, "VL")
    makeGameBtn("nf_name", "nf_desc", 2, "NF")
    makeGameBtn("ff_name", "ff_desc", 3, "FF")

    TS:Create(bg, TweenInfo.new(.4), { BackgroundTransparency = .05 }):Play()
    TS:Create(title, TweenInfo.new(.6), { TextTransparency = 0 }):Play()
end

