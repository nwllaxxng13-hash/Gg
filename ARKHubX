    local raycastParamsCache = RaycastParams.new(); raycastParamsCache.FilterType = Enum.RaycastFilterType.Exclude
    local function isBlocked(o, tp)
        if ignoreListDirty then rebuildIgnoreList() end
        raycastParamsCache.FilterDescendantsInstances = cachedIgnoreList
        local r = Workspace:Raycast(o, tp-o, raycastParamsCache)
        if r and r.Instance then
