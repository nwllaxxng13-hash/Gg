    local EF = Workspace:FindFirstChild("VL_EspLines") or Instance.new("Folder", Workspace)
    EF.Name = "VL_EspLines"
    local EL = {}
    local function isEnemy(pl)
        if pl == LP then return false end
        if LP.Team and pl.Team == LP.Team then return false end
        return true
    end
    local function rmE(pl)
        local e = EL[pl]; if not e then return end
        for _, x in ipairs({e.beam, e.attachA, e.attachB, e.targetPart}) do if x then x:Destroy() end end
        EL[pl] = nil
    end
    local function buildE(pl)
        if not isEnemy(pl) then return end
        local ch = pl.Character; if not ch then return end
        local h = ch:FindFirstChild("Head"); local r = ch:FindFirstChild("HumanoidRootPart")
        if not h or not r then return end
        rmE(pl)
        local aA = Instance.new("Attachment", h); aA.Name = "VLEA"
        local tp = Instance.new("Part", EF); tp.Name = "VLET"; tp.Size = Vector3.new(.05,.05,.05)
        tp.Anchored = true; tp.CanCollide = false; tp.CanQuery = false; tp.CanTouch = false; tp.Transparency = 1
        local aB = Instance.new("Attachment", tp); aB.Name = "VLEB"
        local bm = Instance.new("Beam", tp); bm.Attachment0 = aA; bm.Attachment1 = aB
        bm.Width0 = .25; bm.Width1 = .25; bm.FaceCamera = true; bm.LightEmission = 1
        bm.Transparency = NumberSequence.new(.3)
        bm.Color = ColorSequence.new(Color3.fromHSV((pl.UserId % 100) / 100, .7, 1))
        EL[pl] = { beam=bm, attachA=aA, attachB=aB, targetPart=tp, head=h, root=r }
    end
    do
        local sec = newSection(tabE, "sec_esp", 1)
        newToggle(sec, "esp_enable", VLState.Esp, function(v)
            VLState.Esp = v
            if v then for _, plr in ipairs(Players:GetPlayers()) do if isEnemy(plr) then buildE(plr) end end
            else for pl in pairs(EL) do rmE(pl) end end
        end, 1, 46)
        newSlider(sec, "esp_dist", 5, 200, VLState.EspDist, function(v) VLState.EspDist = v end, 2, 60, 0)
    end
    task.spawn(function()
        while task.wait(.4) do
            if VLState.Esp then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if isEnemy(plr) then
                        local ch = plr.Character
                        if ch and ch:FindFirstChild("Head") and ch:FindFirstChild("HumanoidRootPart") then
                            local e = EL[plr]
                            if (not e) or (not e.head or not e.head.Parent) or (e.head.Parent ~= ch.Head) then buildE(plr) end
                        else if EL[plr] then rmE(plr) end end
                    else if EL[plr] then rmE(plr) end end
                end
            end
        end
    end)
    RS.RenderStepped:Connect(function()
        if VLState.Esp then
            for plr, e in pairs(EL) do
                if not e.head or not e.head.Parent or not e.root or not e.root.Parent then rmE(plr)
                else e.targetPart.Position = e.head.Position + (e.root.CFrame.LookVector * VLState.EspDist) end
            end
        end
        if not VLState.Court.Valid then return end
        local tg, sm = getFacingTarget()
        if tg then
            VT.Position = tg
            if sm then VT.Color = Color3.fromRGB(0,200,255); VL.Color = Color3.fromRGB(255,255,255); VR.Color = Color3.fromRGB(255,255,255)
            elseif tg == VLState.Court.LT then VT.Color = Color3.fromRGB(255,0,0); VL.Color = Color3.fromRGB(255,0,0); VR.Color = Color3.fromRGB(255,255,255)
            else VT.Color = Color3.fromRGB(255,0,0); VL.Color = Color3.fromRGB(255,255,255); VR.Color = Color3.fromRGB(255,0,0) end
        end
        if not VLState.AutoCorner or not tg then return end
        local ch = LP.Character; if not ch then return end
        local r = ch:FindFirstChild("HumanoidRootPart"); local h = ch:FindFirstChildOfClass("Humanoid")
        if not r or not h then return end
        local st = h:GetState()
        local jp = (st == Enum.HumanoidStateType.Jumping) or (st == Enum.HumanoidStateType.Freefall) or (r.AssemblyLinearVelocity.Y > .5)
        if jp then r.CFrame = CFrame.new(r.Position, Vector3.new(tg.X, r.Position.Y, tg.Z)) end
    end)
