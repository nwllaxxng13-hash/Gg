    local function calcFlightTime(sp, tp, power) return (Vector3.new(tp.X,0,tp.Z) - Vector3.new(sp.X,0,sp.Z)).Magnitude / power end
    local function predictIntercept(qbPos, recPos, recVel, power, lm) local t = calcFlightTime(qbPos, recPos, power); return recPos + (recVel * t * lm), t end
    local function calcThrowVel(sp, tp, tt)
        local d = tp - sp
        local vxz = Vector3.new(d.X,0,d.Z) / tt
        local vy = (d.Y + 0.5 * Gravity * (tt^2)) / tt
        return vxz + Vector3.new(0, vy, 0)
    end
    local function getValidTargets()
        if not FFState.TargetingEnabled then return {} end
        local valid = {}; local cam = getCam(); if not cam then return {} end
        local sc = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        local lch = LP.Character; if not lch or not lch:FindFirstChild("HumanoidRootPart") then return {} end
        local qbPos = lch.HumanoidRootPart.Position
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LP then
                local isSameTeam = plr.Team == LP.Team
                if not (FFState.TeammateOnly and not isSameTeam) then
                    local ch = plr.Character
                    if ch and ch:FindFirstChild("HumanoidRootPart") and ch:FindFirstChildOfClass("Humanoid") and ch:FindFirstChildOfClass("Humanoid").Health > 0 then
                        local rt = ch.HumanoidRootPart
                        if (rt.Position - qbPos).Magnitude <= FFState.TargetRange then
                            local sp, on = cam:WorldToViewportPoint(rt.Position)
                            if on then table.insert(valid, {Player = plr, Dist = (Vector2.new(sp.X,sp.Y) - sc).Magnitude}) end
                        end
                    end
                end
            end
        end
        table.sort(valid, function(a,b) return a.Dist < b.Dist end)
        local sorted = {}
        for _, v in ipairs(valid) do table.insert(sorted, v.Player) end
        return sorted
    end
    local function drawTrajectory(sp, vel, ft, pp)
        if not FFState.ShowTrajectory then
            for _, p in ipairs(FFState.TrajectoryLines) do p.Transparency = 1 end
            FFState.CatchMarker.Transparency = 1; return
        end
        local nSeg = math.clamp(math.floor(ft * 25), 8, #FFState.TrajectoryLines)
        local tStep = ft / nSeg; local lastPos = sp
        for i, part in ipairs(FFState.TrajectoryLines) do
            if i <= nSeg then
                local t = i * tStep
                local nextPos = sp + (vel * t) + (Vector3.new(0, -0.5 * Gravity * t^2, 0))
                local d = (nextPos - lastPos).Magnitude
                part.Size = Vector3.new(.12,.12,d)
                part.CFrame = CFrame.lookAt(lastPos, nextPos) * CFrame.new(0,0,-d/2)
                part.Transparency = .1 + (.5 * (i/nSeg))
                lastPos = nextPos
            else part.Transparency = 1 end
        end
        FFState.CatchMarker.Position = pp; FFState.CatchMarker.Transparency = .3
    end
    local function clearTraj() for _, p in ipairs(FFState.TrajectoryLines) do p.Transparency = 1 end; FFState.CatchMarker.Transparency = 1 end
    local function getAssistVel(qbRoot, recRoot)
        if not recRoot or FFState.AssistMode == "Off" then return nil end
        local tp = recRoot.Position; local rv = recRoot.AssemblyLinearVelocity
        local lm = FFState.LeadMultiplier
        if FFState.AssistMode == "Direction" then lm = 0 end
        local pp, ft = predictIntercept(qbRoot.Position, tp, rv, FFState.ThrowPower, lm)
        return calcThrowVel(qbRoot.Position, pp, ft), ft, pp
    end
