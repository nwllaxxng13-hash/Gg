-- Boot
-- ============================================================
local function boot(gameType)
    buildMainFrame()
    buildSharedTabs()
    if gameType == "VL" then
        buildVL(); switchTab("tab_vl_corner")
    elseif gameType == "NF" then
        build99NIF(); switchTab("tab_nf_main")
    elseif gameType == "FF" then
        buildFF(); switchTab("tab_ff_receiver")
    elseif gameType == "PL" then
        buildPrisonLife(); switchTab("tab_pl_aim")
    end
    mainShown = true
    Main.Visible = true; MainScale.Scale = 0
    TS:Create(MainScale, TweenInfo.new(.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = autoScale() }):Play()
    TS:Create(blur, TweenInfo.new(.5), { Size = 14 }):Play()
    task.spawn(function()
        local cam = getCam()
        while task.wait(1) do
            local c = getCam()
            if c and c ~= cam then
                cam = c
                local s = autoScale()
                MainScale.Scale = s; NotifyScale.Scale = s; MiniScale.Scale = s
            end
        end
    end)
    print(string.format("[Ark Hub v5.0.0] Loaded | Game:%s | Admin:%s | Lang:%s", gameType, tostring(IS_ADMIN), LANG))
end

