            end
            if isAuto then Camera.CFrame = origCF end
            if ball then
                for _, v in pairs(ball:GetChildren()) do
                    if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") or v:IsA("VectorForce") or v:IsA("BodyForce") or v:IsA("BodyPosition") then v:Destroy() end
                end
                local st = tick(); local conn
                conn = RS.Heartbeat:Connect(function()
