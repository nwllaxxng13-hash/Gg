local function applyA2Tabs()
    for n, b in pairs(TabButtons) do
        local on = (n == ActiveTab)
        local c = on and Themes[Config.Theme].base or Color3.fromRGB(28,28,42)
        TS:Create(b, TweenInfo.new(.2), { BackgroundColor3 = c }):Play()
    end
end
local function setBadge(tabKey, visible)
    local b = TabBadges[tabKey]; if not b then return end
    if visible then
        b.Visible = true; b.Size = UDim2.fromOffset(0,0)
        TS:Create(b, TweenInfo.new(.3, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(20,20) }):Play()
    else
        TS:Create(b, TweenInfo.new(.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.fromOffset(0,0) }):Play()
        task.delay(.2, function() b.Visible = false end)
    end
end
local function switchTab(name)
    ActiveTab = name
    for n, f in pairs(TabFrames) do f.Visible = (n == name) end
    applyA2Tabs()
    if name == "tab_admin" and TabBadges.tab_admin then
        setBadge("tab_admin", false)
