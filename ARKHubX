    local function createFakeArms()
        local ch = LP.Character
        if not ch then return end
        local rightSrc = ch:FindFirstChild("Right Arm") or ch:FindFirstChild("RightHand")
        local leftSrc = ch:FindFirstChild("Left Arm") or ch:FindFirstChild("LeftHand")
        if not rightSrc or not leftSrc then return end
        local rClone = Instance.new("Part", ch)
        rClone.Name = "Ark_FF_RArm"
        rClone.Size = Vector3.new(rightSrc.Size.X * FFState.Thickness, FFState.Reach, rightSrc.Size.Z * FFState.Thickness)
        rClone.Transparency = 1; rClone.CanCollide = false; rClone.Massless = true; rClone.Anchored = true
        rClone.CanQuery = false; rClone.CanTouch = true
        local lClone = Instance.new("Part", ch)
        lClone.Name = "Ark_FF_LArm"
        lClone.Size = Vector3.new(leftSrc.Size.X * FFState.Thickness, FFState.Reach, leftSrc.Size.Z * FFState.Thickness)
        lClone.Transparency = 1; lClone.CanCollide = false; lClone.Massless = true; lClone.Anchored = true
        lClone.CanQuery = false; lClone.CanTouch = true
        FFState.FakeArms = { Right = rClone, Left = lClone }
    end
    local function removeFakeArms()
        if FFState.FakeArms.Right then FFState.FakeArms.Right:Destroy() end
        if FFState.FakeArms.Left then FFState.FakeArms.Left:Destroy() end
        FFState.FakeArms = {}
    end
    local function refreshArms()
        removeFakeArms()
        if FFState.MagsEnabled then createFakeArms() end
    end

    local function calcFlightTime(sp, tp, power)
        local d = (Vector3.new(tp.X, 0, tp.Z) - Vector3.new(sp.X, 0, sp.Z)).Magnitude
        return d / power
    end
    local function predictIntercept(qbPos, recPos, recVel, power, lm)
        local t = calcFlightTime(qbPos, recPos, power)
        return recPos + (recVel * t * lm), t
    end
    local function calcThrowVel(sp, tp, tt)
        local d = tp - sp
        local vxz = Vector3.new(d.X, 0, d.Z) / tt
        local vy = (d.Y + 0.5 * Gravity * (tt ^ 2)) / tt
        return vxz + Vector3.new(0, vy, 0)
    end
    local function getValidTargets()
        if not FFState.TargetingEnabled then return {} end
        local valid = {}
        local cam = getCam(); if not cam then return {} end
        local sc = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local lch = LP.Character
        if not lch or not lch:FindFirstChild("HumanoidRootPart") then return {} end
        local qbPos = lch.HumanoidRootPart.Position
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LP then
                local isSameTeam = plr.Team == LP.Team
                if not (FFState.TeammateOnly and not isSameTeam) then
                    local ch = plr.Character
                    if ch and ch:FindFirstChild("HumanoidRootPart") and ch:FindFirstChildOfClass("Humanoid") and ch:FindFirstChildOfClass("Humanoid").Health > 0 then
                        local rt = ch.HumanoidRootPart
                        local d = (rt.Position - qbPos).Magnitude
                        if d <= FFState.TargetRange then
                            local sp, on = cam:WorldToViewportPoint(rt.Position)
                            if on then
                                local dc = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
                                table.insert(valid, {Player = plr, Dist = dc})
                            end
                        end
                    end
                end
            end
        end
        table.sort(valid, function(a, b) return a.Dist < b.Dist end)
        local sorted = {}
        for _, v in ipairs(valid) do table.insert(sorted, v.Player) end
        return sorted
    end
    local function drawTrajectory(sp, vel, ft, pp)
        if not FFState.ShowTrajectory then
            for _, p in ipairs(FFState.TrajectoryLines) do p.Transparency = 1 end
            FFState.CatchMarker.Transparency = 1
            return
        end
        local nSeg = math.clamp(math.floor(ft * 25), 8, #FFState.TrajectoryLines)
        local tStep = ft / nSeg
        local lastPos = sp
        for i, part in ipairs(FFState.TrajectoryLines) do
            if i <= nSeg then
                local t = i * tStep
                local nextPos = sp + (vel * t) + (Vector3.new(0, -0.5 * Gravity * t^2, 0))
                local d = (nextPos - lastPos).Magnitude
                part.Size = Vector3.new(.12, .12, d)
                part.CFrame = CFrame.lookAt(lastPos, nextPos) * CFrame.new(0, 0, -d / 2)
                part.Transparency = .1 + (.5 * (i / nSeg))
                lastPos = nextPos
            else
                part.Transparency = 1
            end
        end
        FFState.CatchMarker.Position = pp
        FFState.CatchMarker.Transparency = .3
    end
    local function clearTraj()
        for _, p in ipairs(FFState.TrajectoryLines) do p.Transparency = 1 end
        FFState.CatchMarker.Transparency = 1
    end
    local function getAssistVel(qbRoot, recRoot)
        if not recRoot or FFState.AssistMode == "Off" then return nil end
        local tp = recRoot.Position
        local rv = recRoot.AssemblyLinearVelocity
        local lm = FFState.LeadMultiplier
        if FFState.AssistMode == "Direction" then lm = 0 end
        local pp, ft = predictIntercept(qbRoot.Position, tp, rv, FFState.ThrowPower, lm)
        return calcThrowVel(qbRoot.Position, pp, ft), ft, pp
    end
    local function cycleTarget()
        local vt = getValidTargets()
        if #vt > 1 then
            local ci = 1
            for i, tgt in ipairs(vt) do
                if tgt == FFState.ManualTarget then ci = i; break end
            end
            local ni = ci + 1
            if ni > #vt then ni = 1 end
            FFState.ManualTarget = vt[ni]
        elseif #vt == 1 then
            FFState.ManualTarget = vt[1]
        end
    end
    local function executeThrow(isAuto)
        if FFState.IsThrowing then return end
        local ch = LP.Character
        if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
        local qbRoot = ch.HumanoidRootPart
        local tool = ch:FindFirstChildOfClass("Tool")
        if not tool then
            local bp = LP:FindFirstChild("Backpack")
            if bp then
                local bpTool = bp:FindFirstChildOfClass("Tool")
                if bpTool then ch.Humanoid:EquipTool(bpTool) end
            end
        end
        local fVel, pp = nil, nil
        if FFState.CurrentTarget and FFState.CurrentTarget.Character then
            local rr = FFState.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
            if rr then fVel, _, pp = getAssistVel(qbRoot, rr) end
        end
        if not fVel or not pp then return end
        FFState.IsThrowing = true
        local rp = qbRoot.Position
        qbRoot.CFrame = CFrame.lookAt(rp, Vector3.new(pp.X, rp.Y, pp.Z))
        local origCF = Camera.CFrame
        local vp = Camera.ViewportSize
        local cx, cy = vp.X / 2, vp.Y / 2
        if isAuto then
            local tApex = fVel.Y / Gravity
            if tApex < 0.1 then tApex = 0.1 end
            local apex = qbRoot.Position + (fVel * tApex) - Vector3.new(0, 0.5 * Gravity * tApex^2, 0)
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, apex)
            task.wait(0.02)
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.wait(0.22)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
        end
        task.spawn(function()
            local ball = nil
            for i = 1, 30 do
                task.wait(.03)
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        if not obj:IsDescendantOf(ch) then
                            local nl = string.lower(obj.Name)
                            if (string.match(nl, "ball") or string.match(nl, "football") or string.match(nl, "pigskin")) and not obj.Anchored then
                                local d = (obj.Position - qbRoot.Position).Magnitude
                                if d < 30 then ball = obj; break end
                            end
                        end
                    end
                end
                if ball then break end
            end
            if isAuto then Camera.CFrame = origCF end
            if ball then
                for _, v in pairs(ball:GetChildren()) do
                    if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") or v:IsA("VectorForce") or v:IsA("BodyForce") or v:IsA("BodyPosition") then
                        v:Destroy()
                    end
                end
                local st = tick()
                local conn
                conn = RS.Heartbeat:Connect(function()
                    if tick() - st > 0.4 or not ball or not ball.Parent then
                        conn:Disconnect(); FFState.IsThrowing = false; return
                    end
                    ball.AssemblyLinearVelocity = fVel
                end)
            else
                FFState.IsThrowing = false
            end
        end)
    end

    local tabR = makeTab("tab_ff_receiver", 1)
    local tabQ = makeTab("tab_ff_qb", 2)
    local tabV = makeTab("tab_ff_visuals", 3)

    do
        local sec = newSection(tabR, "sec_mags", 1)
        newToggle(sec, "mags_enable", FFState.MagsEnabled, function(v)
            FFState.MagsEnabled = v
            refreshArms()
            notify("Flag Football", v and "Mags ON" or "Mags OFF")
        end, 1, 46)
        newSlider(sec, "mags_reach", 5, 50, FFState.Reach, function(v)
            FFState.Reach = v; refreshArms()
        end, 2, 60, 0)
        newSlider(sec, "mags_thick", 1, 50, FFState.Thickness, function(v)
            FFState.Thickness = v; refreshArms()
        end, 3, 60, 0)
    end
    do
