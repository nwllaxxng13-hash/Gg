    local CurrentTarget = nil
    local function selectTarget()
        local best, bestScore = nil, math.huge
        local Center = PLState.FovFollowMouse and UIS:GetMouseLocation() or Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local myHRP = getHRP(); if not myHRP then return nil end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character and enemyPass(plr, PLState.IgnoreTeams, PLState.IgnoreFlags) then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local tp = plr.Character:FindFirstChild(PLState.LockPart) or plr.Character:FindFirstChild("Head")
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and tp and root then
                    local sp, on = Camera:WorldToViewportPoint(tp.Position)
                    if on then
                        local fov = (Vector2.new(sp.X, sp.Y) - Center).Magnitude
                        if fov <= PLState.FOVSize then
                            local wd = (root.Position - myHRP.Position).Magnitude
                            local score = (PLState.TargetPriority == "Distance") and wd or fov
                            local passW = isVisible(tp)
                            local close = wd < 10
                            if (PLState.CloseRangeFix and close) or passW then
                                if score < bestScore then best = tp; bestScore = score end
                            end
                        end
                    end
                end
            end
        end
        return best
    end

