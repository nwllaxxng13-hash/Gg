        newToggle(sec, "qb_team_only", FFState.TeammateOnly, function(v) FFState.TeammateOnly = v end, 2, 46)
        newToggle(sec, "qb_camlock", FFState.CameraLockEnabled, function(v) FFState.CameraLockEnabled = v end, 3, 46)
        newSlider(sec, "qb_range", 50, 500, FFState.TargetRange, function(v) FFState.TargetRange = v end, 4, 60, 0)
    end
    do
        local sec = newSection(tabQ, "sec_throw", 2)
        newDropdown(sec, "qb_assist", {"Precision", "Lead", "Direction", "Off"}, FFState.AssistMode, function(v) FFState.AssistMode = v end, 1, 46)
        newSlider(sec, "qb_power", 40, 150, FFState.ThrowPower, function(v) FFState.ThrowPower = v end, 2, 60, 0)
        newSlider(sec, "qb_lead", 0, 3, FFState.LeadMultiplier, function(v) FFState.LeadMultiplier = v end, 3, 60, 1)
    end
    do
        local sec = newSection(tabV, "sec_ball_render", 1)
        newToggle(sec, "v_bubble", FFState.BubbleEnabled, function(v) FFState.BubbleEnabled = v end, 1, 46)
        newSlider(sec, "v_bubble_size", 1, 50, FFState.BubbleRadius, function(v) FFState.BubbleRadius = v end, 2, 60, 0)
    end
    do
        local sec = newSection(tabV, "sec_qb_visuals", 2)
        newToggle(sec, "v_arc", FFState.ShowTrajectory, function(v)
            FFState.ShowTrajectory = v
            if not v then clearTraj() end
        end, 1, 46)
        newToggle(sec, "v_debug", FFState.ShowDebug, function(v)
            FFState.ShowDebug = v
            FFState.DebugText.Visible = v
        end, 2, 46)
        local colorOpts = {
            {value="Green", display="Green"},
            {value="Red", display="Red"},
            {value="Blue", display="Blue"},
            {value="Yellow", display="Yellow"},
            {value="Cyan", display="Cyan"},
            {value="Magenta", display="Magenta"},
        }
        local colorMap = {
            Green = Color3.fromRGB(0,255,128), Red = Color3.fromRGB(255,50,50),
            Blue = Color3.fromRGB(50,150,255), Yellow = Color3.fromRGB(255,220,50),
            Cyan = Color3.fromRGB(0,220,255), Magenta = Color3.fromRGB(255,80,220),
        }
        newDropdown(sec, "v_arc_color", colorOpts, "Green", function(v)
            local c = colorMap[v] or Color3.fromRGB(0,255,128)
            FFState.TrajectoryColor = c
            for _, p in ipairs(FFState.TrajectoryLines) do p.Color = c end
        end, 3, 46)
    end

    local mobileGui = Instance.new("ScreenGui", PG)
    mobileGui.Name = "Ark_FF_MobileHUD"
    mobileGui.ResetOnSpawn = false
    mobileGui.DisplayOrder = 9997
    local hudContainer = Instance.new("Frame", mobileGui)
    hudContainer.AnchorPoint = Vector2.new(1, .5)
    hudContainer.Size = UDim2.fromOffset(60, 200)
    hudContainer.Position = UDim2.new(1, -8, .5, 0)
    hudContainer.BackgroundTransparency = 1
    local hudLayout = Instance.new("UIListLayout", hudContainer)
    hudLayout.Padding = UDim.new(0, 10)
    hudLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local function mkMobileBtn(name, text, ord)
        local b = Instance.new("TextButton", hudContainer)
        b.Name = name; b.Size = UDim2.new(1, 0, 0, 55)
        b.BackgroundColor3 = Color3.fromRGB(25, 100, 150)
        b.BackgroundTransparency = .2
        b.Font = Enum.Font.SourceSansBold
        b.Text = text; b.TextColor3 = Color3.new(1,1,1); b.TextSize = 14
        b.TextWrapped = true; b.LayoutOrder = ord
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        return b
    end
    local btnToggle = mkMobileBtn("Menu", "Menu\n(Open)", 1)
    local btnTarget = mkMobileBtn("Target", "Target\n(T)", 2)
    local btnThrow = mkMobileBtn("Throw", "Throw\n(G)", 3)

    btnToggle.MouseButton1Click:Connect(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
        task.wait(.05)
        VIM:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
    end)
    btnTarget.MouseButton1Click:Connect(cycleTarget)
    btnThrow.MouseButton1Click:Connect(function() executeThrow(true) end)

    RS.RenderStepped:Connect(function(dt)
        if FFState.MagsEnabled then
            local ch = LP.Character
            if ch then
                local rSrc = ch:FindFirstChild("Right Arm") or ch:FindFirstChild("RightHand")
                local lSrc = ch:FindFirstChild("Left Arm") or ch:FindFirstChild("LeftHand")
                if rSrc and lSrc and FFState.FakeArms.Right and FFState.FakeArms.Left then
                    FFState.FakeArms.Right.CFrame = rSrc.CFrame * CFrame.new(0, (-FFState.Reach / 2) + FFState.YOffset, 0)
                    FFState.FakeArms.Left.CFrame = lSrc.CFrame * CFrame.new(0, (-FFState.Reach / 2) + FFState.YOffset, 0)
                end
            end
        end
        if FFState.BubbleEnabled then
            local ball = nil
            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj:IsA("BasePart") and obj.Name == "Ball" then ball = obj; break end
            end
            if ball then
                FFState.VisualBubble.Size = Vector3.new(FFState.BubbleRadius*2, FFState.BubbleRadius*2, FFState.BubbleRadius*2)
                FFState.VisualBubble.CFrame = ball.CFrame
                if FFState.VisualBubble.Parent ~= Workspace then FFState.VisualBubble.Parent = Workspace end
            else
                if FFState.VisualBubble.Parent then FFState.VisualBubble.Parent = nil end
            end
        else
            if FFState.VisualBubble.Parent then FFState.VisualBubble.Parent = nil end
        end
        FFState.UpdateThrottle = FFState.UpdateThrottle + dt
        if FFState.UpdateThrottle >= .04 then
            FFState.UpdateThrottle = 0
            local ch = LP.Character
            if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
            local qbRoot = ch.HumanoidRootPart
            local vt = getValidTargets()
            local stillValid = false
            if FFState.ManualTarget then
                for _, tg in ipairs(vt) do
                    if tg == FFState.ManualTarget then stillValid = true; break end
                end
            end
            if not stillValid then FFState.ManualTarget = vt[1] end
            FFState.CurrentTarget = FFState.ManualTarget
            if FFState.CurrentTarget and FFState.CurrentTarget.Character and FFState.AssistMode ~= "Off" then
                local rr = FFState.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                if rr then
                    local rVel, ft, pp = getAssistVel(qbRoot, rr)
                    if rVel then
                        drawTrajectory(qbRoot.Position, rVel, ft, pp)
                        if FFState.CameraLockEnabled and not FFState.IsThrowing then
                            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, rr.Position)
                        end
                        if FFState.ShowDebug then
                            FFState.DebugText.Text = string.format(
                                "[T] Target: %s\n[UI] Mode: %s\nDistance: %.1f\n[G] Auto-Throw\n[Click] Manual",
                                FFState.CurrentTarget.Name, FFState.AssistMode, (rr.Position - qbRoot.Position).Magnitude
                            )
                        end
                    end
                end
            else
                clearTraj()
                if FFState.ShowDebug then
                    FFState.DebugText.Text = string.format("[T] Target: None\n[UI] Mode: %s\nWaiting for receiver...", FFState.AssistMode)
                end
            end
        end
    end)

    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if FFState.MagsEnabled and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            local ch = LP.Character
            if not ch then return end
            local rSrc = ch:FindFirstChild("Right Arm") or ch:FindFirstChild("RightHand")
            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj:IsA("BasePart") and obj.Name == "Ball" then
                    if rSrc and (rSrc.Position - obj.Position).Magnitude <= FFState.Reach + (FFState.Thickness * 2) then
                        if firetouchinterest then
                            firetouchinterest(rSrc, obj, 0)
                            firetouchinterest(rSrc, obj, 1)
                        else
                            obj.CFrame = rSrc.CFrame
                        end
                    end
                end
            end
        end
        if input.KeyCode == Enum.KeyCode.T then cycleTarget() end
        if input.KeyCode == Enum.KeyCode.G then executeThrow(true) end
    end)
    UIS.InputEnded:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not FFState.IsThrowing then executeThrow(false) end
        end
    end)
end

