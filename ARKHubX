    local md, ms2, mp
    MiniIcon.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            md = true; ms2 = i.Position; mp = MiniIcon.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    md = false
                    Config.MiniX = MiniIcon.Position.X.Scale; Config.MiniY = MiniIcon.Position.Y.Scale; saveCfg()
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if md and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ms2
            TS:Create(MiniIcon, TweenInfo.new(.06, Enum.EasingStyle.Quad), {
                Position = UDim2.new(mp.X.Scale, mp.X.Offset + d.X, mp.Y.Scale, mp.Y.Offset + d.Y) }):Play()
        end
    end)

    local hue = 0
    task.spawn(function()
        while task.wait(.05) do
            if Themes[Config.Theme].rgb then
                hue = (hue + .005) % 1
                local c = Color3.fromHSV(hue,.65,1)
                applyA(c); MiniIcon.BackgroundColor3 = Color3.fromHSV(hue,.55,.35)
            end
        end
    end)
    applyA(Themes[Config.Theme].base)
    MiniIcon.BackgroundColor3 = Color3.fromRGB(30,20,55)
end

