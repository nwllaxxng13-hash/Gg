-- WINDUI
-- ==========================================
local WindUI
do
    local ok, res = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
    end)
    if ok and res then WindUI = res
    else WindUI = require(ReplicatedStorage:WaitForChild("WindUI"):WaitForChild("Init")) end
end

local Window = WindUI:CreateWindow({
    Title = "ALT FARM ONLY",
    Author = "Fox for Jack",
    Icon = "solar:wind-bold",
    Theme = "Dark",
    ToggleKey = Enum.KeyCode.RightControl,
})

Window:Tag({ Title = "Alt Farm v1.6 | Textbox target", Color = "ElementBackground" })

local MainTab = Window:Tab({ Title = "MAIN", Icon = "crosshair" })
local MainSection = MainTab:Section({ Title = "Alt Farm Control", Box = true })

MainSection:Input({
    Title = "Target Player Name",
    Desc = "Exact Roblox username (case-sensitive)",
    Placeholder = "PlayerName",
    Value = TargetPlayerName,
    Callback = function(text)
        TargetPlayerName = TrimName(text or "")
        SaveConfig()
    end,
})

MainSection:Input({
    Title = "Target Kaiju",
    Desc = "Ex. Gojira 1954",
    Placeholder = "Gojira 1954",
    Value = TargetKaiju,
    Callback = function(text)
        if text and text ~= "" then
            TargetKaiju = text
            SaveConfig()
        end
    end,
})

MainSection:Toggle({
    Title = "Auto Alt Farm v2",
    Desc = "ON: void when HP <= 1000 | OFF + V3 off: v1 damage -> void",
    Value = AltFarmV2Enabled,
    Callback = function(v)
        AltFarmV2Enabled = v == true
        if v then AltFarmV3Enabled = false end
        SaveConfig()
    end,
})

MainSection:Toggle({
    Title = "Auto Farm Alt V3",
    Desc = "Spawn + warp only | NO void",
    Value = AltFarmV3Enabled,
    Callback = function(v)
        AltFarmV3Enabled = v == true
        if v then AltFarmV2Enabled = false end
        SaveConfig()
    end,
})

MainSection:Toggle({
    Title = "Start Farm",
    Desc = "Always spawn + warp to name in textbox",
    Value = AltFarmEnabled,
    Callback = function(v)
        AltFarmEnabled = v
        LastHealth = nil
        VoidDepthY = -5000
        VoidBusy = false
        if v then FireSpawn() end
    end,
})

local MiscSection = MainTab:Section({ Title = "Misc", Box = true })
MiscSection:Toggle({
    Title = "Anti AFK Bypass",
    Desc = "Activity pulse every 5s (20min idle kick)",
    Value = AntiAfkEnabled,
    Callback = function(v)
        AntiAfkEnabled = v == true
        SaveConfig()
    end,
})

-- ==========================================
-- LOOPS
-- ==========================================
L.CharacterAdded:Connect(function()
    task.wait(0.8)
    LastHealth = nil
    VoidDepthY = -5000
    VoidBusy = false
    if AltFarmEnabled then
        FireSpawn()
    end
end)

-- Main farm loop (fast, no long sleeps)
task.spawn(function()
    while true do
        if AltFarmEnabled then
            FarmPulse()
        else
            LastHealth = nil
        end
        task.wait(0.06)
    end
end)

-- Backup warp every frame-ish (fixes "stops farming")
RunService.Heartbeat:Connect(function()
    if not AltFarmEnabled or VoidBusy then return end

    local hum = GetMyHumanoid()
    local hrp = GetMyHRP()
    if not hum or not hrp or hum.Health <= 0 then return end

    if AltFarmV3Enabled or not ShouldWarpVoid(false, hum.Health) then
        local target = GetTextboxTarget()
        if target and IsTargetAlive(target) then
            WarpToTarget(target)
        end
    end

    LastFarmPulse = tick()
end)

-- Void heartbeat (v1/v2 only)
RunService.Heartbeat:Connect(function()
    if not AltFarmEnabled or AltFarmV3Enabled or VoidBusy then return end

    local hrp = GetMyHRP()
    local hum = GetMyHumanoid()
    if not hrp or not hum then return end

    if IsVoidingLowHP(hum) then
        VoidDepthY = VoidDepthY - VoidStep
        hrp.CFrame = CFrame.new(0, VoidDepthY, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, -500, 0)
        ForceKillCharacter()
    elseif hrp.Position.Y > 800 then
        VoidDepthY = VoidDepthY - VoidStep
        hrp.CFrame = CFrame.new(0, VoidDepthY, 0)
        ForceKillCharacter()
    end

    if hrp.Position.Y < -4000 then
        hrp.AssemblyLinearVelocity = Vector3.new(0, -300, 0)
    end
end)

-- Watchdog: if farm on but stuck > 3s without pulse, force respawn farm
task.spawn(function()
    while true do
        task.wait(2)
        if AltFarmEnabled and not VoidBusy then
            if tick() - LastFarmPulse > 3 then
                FireSpawn()
                local t = GetTextboxTarget()
                if t and IsTargetAlive(t) then
                    WarpToTarget(t)
                end
                LastFarmPulse = tick()
            end
        end
    end
end)

-- Anti AFK every 5 seconds
task.spawn(function()
    while true do
        task.wait(5)
        if AntiAfkEnabled then
            DoAntiAfkPulse()
        end
    end
end)

print("[FOX] ALT FARM ONLY v1.6 | Textbox target | Anti AFK 5s")
