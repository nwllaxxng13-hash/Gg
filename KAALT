--[[
    ALT FARM ONLY v1.4 - Fox for Jack
    v1: any damage -> void die
    v2: HP <= 1000 -> void die immediately (no damage trigger)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local L = Players.LocalPlayer

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local FireServerRemote = Remotes:WaitForChild("FireServer")

local AltFarmEnabled = false
local AltFarmV2Enabled = false
local SelectedPlayerName = nil
local TargetKaiju = "Gojira 1954"
local LastHealth = nil
local VoidDepthY = -5000
local VoidStep = 25000
local WarpOffset = CFrame.new(0, 4, -6)
local HPVoidMax = 1000

local ConfigFile = "FoxAltFarmOnly.json"

local function SaveConfig()
    pcall(function()
        if writefile then
            writefile(ConfigFile, HttpService:JSONEncode({
                Kaiju = TargetKaiju,
                Player = SelectedPlayerName,
                V2 = AltFarmV2Enabled,
            }))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(ConfigFile) then
            local d = HttpService:JSONDecode(readfile(ConfigFile))
            if d then
                TargetKaiju = d.Kaiju or TargetKaiju
                SelectedPlayerName = d.Player
                AltFarmV2Enabled = d.V2 == true
            end
        end
    end)
end
LoadConfig()

local function GetPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= L then table.insert(list, p.Name) end
    end
    table.sort(list)
    return list
end

local function GetPlayerByName(name)
    if not name or name == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == name then return p end
    end
    return nil
end

local function IsTargetAlive(target)
    if not target or not target.Parent then return false end
    local char = target.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return hum and hrp and hum.Health > 0
end

local function GetMyChar()
    return L.Character
end

local function GetMyHRP()
    local char = GetMyChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetMyHumanoid()
    local char = GetMyChar()
    return char and char:FindFirstChild("Humanoid")
end

local function FireSpawn()
    pcall(function()
        FireServerRemote:FireServer("Spawn", TargetKaiju, "Hong Kong")
    end)
end

local function WarpToTarget(target)
    local myHRP = GetMyHRP()
    if not myHRP or not IsTargetAlive(target) then return end
    local tHRP = target.Character.HumanoidRootPart
    myHRP.CFrame = tHRP.CFrame * WarpOffset
    myHRP.AssemblyLinearVelocity = Vector3.zero
    myHRP.AssemblyAngularVelocity = Vector3.zero
end

local function ForceKillCharacter()
    local char = GetMyChar()
    local hum = GetMyHumanoid()
    if not char or not hum then return end
    pcall(function() hum:TakeDamage(hum.MaxHealth + 99999) end)
    pcall(function() hum.Health = 0 end)
    pcall(function() char:BreakJoints() end)
end

local function WarpToVoidAndDie()
    local hrp = GetMyHRP()
    local hum = GetMyHumanoid()
    if not hrp or not hum then return false end

    VoidDepthY = VoidDepthY - VoidStep

    local attempts = 0
    while hum and hum.Parent and hum.Health > 0 and attempts < 12 do
        attempts = attempts + 1
        local depth = VoidDepthY - (attempts * VoidStep)
        hrp.CFrame = CFrame.new(0, depth, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, -500, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero

        task.wait(0.08)
        ForceKillCharacter()
        task.wait(0.12)

        hum = GetMyHumanoid()
        hrp = GetMyHRP()
        if not hum then return true end
    end

    hum = GetMyHumanoid()
    return hum == nil or (hum and hum.Health <= 0)
end

local function TrackHealth()
    local hum = GetMyHumanoid()
    if not hum then
        LastHealth = nil
        return false, false, 0
    end
    local cur = hum.Health
    local tookDamage = false
    local isDead = cur <= 0
    if LastHealth and cur < LastHealth - 0.5 then
        tookDamage = true
    end
    LastHealth = cur
    return tookDamage, isDead, cur
end

local function ShouldWarpVoid(tookDamage, currentHP)
    if AltFarmV2Enabled then
        return currentHP > 0 and currentHP <= HPVoidMax
    end
    return tookDamage
end

local function IsVoidingLowHP(hum)
    if not hum or hum.Health <= 0 then return false end
    if not AltFarmV2Enabled then return false end
    return hum.Health <= HPVoidMax
end

-- ==========================================
-- WINDUI
-- ==========================================
local WindUI
do
    local ok, res = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
    end)
    if ok and res then WindUI = res
    else WindUI = require(ReplicatedStorage:WaitForChild("WindUI"):WaitForChild("Init")) end
end

local Window = WindUI:CreateWindow({
    Title = "ALT FARM ONLY",
    Author = "Fox for Jack",
    Icon = "solar:wind-bold",
    Theme = "Dark",
    ToggleKey = Enum.KeyCode.RightControl,
})

Window:Tag({ Title = "Alt Farm v1.4 - V2 HP<=1000", Color = "ElementBackground" })

local MainTab = Window:Tab({ Title = "MAIN", Icon = "crosshair" })
local MainSection = MainTab:Section({ Title = "Alt Farm Control", Box = true })

local playerOptions = GetPlayerList()
if #playerOptions == 0 then table.insert(playerOptions, "(No players)") end
if SelectedPlayerName and not table.find(playerOptions, SelectedPlayerName) then
    table.insert(playerOptions, 1, SelectedPlayerName)
end

local defaultSelect = SelectedPlayerName or playerOptions[1]

local DropdownRef = MainSection:Dropdown({
    Title = "Select target Player",
    Desc = "Pick player to warp farm",
    Values = playerOptions,
    Value = defaultSelect,
    Multi = false,
    Callback = function(val)
        if val and val ~= "(No players)" then
            SelectedPlayerName = val
            SaveConfig()
        end
    end,
})

MainSection:Button({
    Title = "Refresh Dropdown",
    Icon = "refresh-ccw",
    Callback = function()
        local fresh = GetPlayerList()
        if #fresh == 0 then fresh = { "(No players)" } end
        if DropdownRef and DropdownRef.Refresh then
            DropdownRef:Refresh(fresh, fresh[1])
        elseif DropdownRef and DropdownRef.SetValues then
            DropdownRef:SetValues(fresh)
        end
        if SelectedPlayerName and table.find(fresh, SelectedPlayerName) then
            if DropdownRef and DropdownRef.SetValue then
                DropdownRef:SetValue(SelectedPlayerName)
            end
        end
    end,
})

MainSection:Input({
    Title = "Target Kaiju",
    Desc = "Ex. Gojira 1954",
    Placeholder = "Gojira 1954",
    Value = TargetKaiju,
    Callback = function(text)
        if text and text ~= "" then
            TargetKaiju = text
            SaveConfig()
        end
    end,
})

MainSection:Toggle({
    Title = "Auto Alt Farm v2",
    Desc = "ON: void when HP <= 1000 | OFF: v1 damage -> void",
    Value = AltFarmV2Enabled,
    Callback = function(v)
        AltFarmV2Enabled = v == true
        SaveConfig()
    end,
})

MainSection:Toggle({
    Title = "Start Farm",
    Desc = "Spawn + warp | void by v1/v2 | respawn loop",
    Value = AltFarmEnabled,
    Callback = function(v)
        AltFarmEnabled = v
        LastHealth = nil
        VoidDepthY = -5000
        if v then FireSpawn() end
    end,
})

-- ==========================================
-- LOOPS
-- ==========================================
L.CharacterAdded:Connect(function()
    task.wait(1.2)
    LastHealth = nil
    VoidDepthY = -5000
    if AltFarmEnabled then
        FireSpawn()
    end
end)

task.spawn(function()
    while true do
        if AltFarmEnabled then
            local target = GetPlayerByName(SelectedPlayerName)
            local hum = GetMyHumanoid()
            local hrp = GetMyHRP()

            if hum and hrp then
                local tookDamage, isDead, currentHP = TrackHealth()

                if isDead then
                    task.wait(0.6)
                    FireSpawn()
                    task.wait(1.4)
                elseif ShouldWarpVoid(tookDamage, currentHP) then
                    WarpToVoidAndDie()
                    task.wait(0.5)
                else
                    FireSpawn()
                    if IsTargetAlive(target) then
                        WarpToTarget(target)
                    else
                        local nearest = nil
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= L and IsTargetAlive(p) then
                                nearest = p
                                break
                            end
                        end
                        if nearest then
                            SelectedPlayerName = nearest.Name
                            SaveConfig()
                            WarpToTarget(nearest)
                        end
                    end
                end
            else
                FireSpawn()
            end
        else
            LastHealth = nil
        end
        task.wait(0.12)
    end
end)

RunService.Heartbeat:Connect(function()
    if not AltFarmEnabled then return end
    local hrp = GetMyHRP()
    local hum = GetMyHumanoid()
    if not hrp or not hum then return end

    if IsVoidingLowHP(hum) then
        VoidDepthY = VoidDepthY - VoidStep
        hrp.CFrame = CFrame.new(0, VoidDepthY, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, -500, 0)
        ForceKillCharacter()
    elseif hrp.Position.Y > 800 then
        VoidDepthY = VoidDepthY - VoidStep
        hrp.CFrame = CFrame.new(0, VoidDepthY, 0)
        ForceKillCharacter()
    end

    if hrp.Position.Y < -4000 then
        hrp.AssemblyLinearVelocity = Vector3.new(0, -300, 0)
    end
end)

print("[FOX] ALT FARM ONLY v1.4 | v2 ON = void when HP <= 1000")
