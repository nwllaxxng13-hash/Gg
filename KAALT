--[[
    ALT FARM ONLY v1.6 - Fox for Jack
    v1: damage -> void | v2: HP <= 1000 -> void | v3: spawn + warp only
    Target = Textbox name | Anti AFK every 5s
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")

local L = Players.LocalPlayer

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local FireServerRemote = Remotes:WaitForChild("FireServer")

local AltFarmEnabled = false
local AltFarmV2Enabled = false
local AltFarmV3Enabled = false
local TargetPlayerName = ""
local TargetKaiju = "Gojira 1954"
local AntiAfkEnabled = false

local LastHealth = nil
local VoidDepthY = -5000
local VoidStep = 25000
local WarpOffset = CFrame.new(0, 4, -6)
local HPVoidMax = 1000

local LastFarmPulse = 0
local VoidBusy = false

local ConfigFile = "FoxAltFarmOnly.json"

local function SaveConfig()
    pcall(function()
        if writefile then
            writefile(ConfigFile, HttpService:JSONEncode({
                Kaiju = TargetKaiju,
                Player = TargetPlayerName,
                V2 = AltFarmV2Enabled,
                V3 = AltFarmV3Enabled,
                AntiAfk = AntiAfkEnabled,
            }))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(ConfigFile) then
            local d = HttpService:JSONDecode(readfile(ConfigFile))
            if d then
                TargetKaiju = d.Kaiju or TargetKaiju
                TargetPlayerName = d.Player or TargetPlayerName or ""
                AltFarmV2Enabled = d.V2 == true
                AltFarmV3Enabled = d.V3 == true
                AntiAfkEnabled = d.AntiAfk == true
            end
        end
    end)
end
LoadConfig()

local function TrimName(s)
    if type(s) ~= "string" then return "" end
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function GetPlayerByName(name)
    name = TrimName(name)
    if name == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == name then return p end
    end
    return nil
end

local function GetTextboxTarget()
    return GetPlayerByName(TargetPlayerName)
end

local function IsTargetAlive(target)
    if not target or not target.Parent then return false end
    local char = target.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return hum and hrp and hum.Health > 0
end

local function GetMyChar()
    return L.Character
end

local function GetMyHRP()
    local char = GetMyChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetMyHumanoid()
    local char = GetMyChar()
    return char and char:FindFirstChild("Humanoid")
end

local function FireSpawn()
    pcall(function()
        FireServerRemote:FireServer("Spawn", TargetKaiju, "Hong Kong")
    end)
end

local function WarpToTarget(target)
    local myHRP = GetMyHRP()
    if not myHRP or not IsTargetAlive(target) then return false end
    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHRP then return false end
    myHRP.CFrame = tHRP.CFrame * WarpOffset
    myHRP.AssemblyLinearVelocity = Vector3.zero
    myHRP.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function ForceKillCharacter()
    local char = GetMyChar()
    local hum = GetMyHumanoid()
    if not char or not hum then return end
    pcall(function() hum:TakeDamage(hum.MaxHealth + 99999) end)
    pcall(function() hum.Health = 0 end)
    pcall(function() char:BreakJoints() end)
end

local function WarpToVoidAndDie()
    if VoidBusy then return false end
    VoidBusy = true
    local hrp = GetMyHRP()
    local hum = GetMyHumanoid()
    if not hrp or not hum then
        VoidBusy = false
        return false
    end

    VoidDepthY = VoidDepthY - VoidStep
    local attempts = 0
    while hum and hum.Parent and hum.Health > 0 and attempts < 12 do
        attempts = attempts + 1
        local depth = VoidDepthY - (attempts * VoidStep)
        hrp.CFrame = CFrame.new(0, depth, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, -500, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.08)
        ForceKillCharacter()
        task.wait(0.12)
        hum = GetMyHumanoid()
        hrp = GetMyHRP()
        if not hum then
            VoidBusy = false
            return true
        end
    end
    hum = GetMyHumanoid()
    VoidBusy = false
    return hum == nil or (hum and hum.Health <= 0)
end

local function TrackHealth()
    local hum = GetMyHumanoid()
    if not hum then
        LastHealth = nil
        return false, false, 0
    end
    local cur = hum.Health
    local tookDamage = false
    local isDead = cur <= 0
    if LastHealth and cur < LastHealth - 0.5 then
        tookDamage = true
    end
    LastHealth = cur
    return tookDamage, isDead, cur
end

local function ShouldWarpVoid(tookDamage, currentHP)
    if AltFarmV3Enabled then return false end
    if AltFarmV2Enabled then
        return currentHP > 0 and currentHP <= HPVoidMax
    end
    return tookDamage
end

local function IsVoidingLowHP(hum)
    if AltFarmV3Enabled then return false end
    if not hum or hum.Health <= 0 then return false end
    if not AltFarmV2Enabled then return false end
    return hum.Health <= HPVoidMax
end

local function DoAntiAfkPulse()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(2, 2))
    end)
    pcall(function()
        local hum = GetMyHumanoid()
        if hum and hum.Health > 0 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

local function FarmPulse()
    if not AltFarmEnabled or VoidBusy then return end

    local target = GetTextboxTarget()
    local hum = GetMyHumanoid()
    local hrp = GetMyHRP()

    if not hum or not hrp then
        FireSpawn()
        return
    end

    local tookDamage, isDead, currentHP = TrackHealth()

    if isDead then
        FireSpawn()
        return
    end

    if ShouldWarpVoid(tookDamage, currentHP) then
        task.spawn(function()
            WarpToVoidAndDie()
        end)
        return
    end

    FireSpawn()
    if target and IsTargetAlive(target) then
        WarpToTarget(target)
    end
end

