-- COURT LOGIC
-- ============================================================
local function findCourt()
    local map = Workspace:FindFirstChild("Map")
    if map and map:FindFirstChild("Court") then return map.Court end
    local c = Workspace:FindFirstChild("Court"); if c then return c end
    for _, d in ipairs(Workspace:GetChildren()) do
        if string.find(string.lower(d.Name), "court", 1, true) then return d end
    end
end
local function findOuterCourt()
    local map = Workspace:FindFirstChild("Map")
    if map and map:FindFirstChild("OuterCourt") then return map.OuterCourt end
    return Workspace:FindFirstChild("OuterCourt")
end
local function collectParts(c)
    local p = {}
    if not c then return p end
    if c:IsA("BasePart") then table.insert(p, c) end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(p, d) end
    end
    return p
end
local function getBounds(parts)
    if #parts == 0 then return nil end
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
    for _, p in ipairs(parts) do
        local pos, h = p.Position, p.Size * 0.5
        mn = Vector3.new(math.min(mn.X, pos.X-h.X), math.min(mn.Y, pos.Y-h.Y), math.min(mn.Z, pos.Z-h.Z))
        mx = Vector3.new(math.max(mx.X, pos.X+h.X), math.max(mx.Y, pos.Y+h.Y), math.max(mx.Z, pos.Z+h.Z))
    end
    return mn, mx, (mn + mx) * 0.5
end
local function computeTargets(court)
    local parts = collectParts(court)
    if #parts == 0 then return nil, "Court ไม่มี BasePart" end
    local mn, mx, center = getBounds(parts)
    local myPos = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"))
        and LP.Character.HumanoidRootPart.Position or (getCam() and getCam().CFrame.Position) or center
    local sx, sz = mx.X - mn.X, mx.Z - mn.Z
    local axis = (sx > sz) and "X" or "Z"
    local av = function(v) return (axis == "X") and v.X or v.Z end
    local mySign = (av(myPos) >= av(center)) and 1 or -1
    local y = center.Y
    local oppAxis = (mySign == 1) and mn or mx
    local L, R
    if axis == "X" then
        L = Vector3.new(oppAxis.X, y, mn.Z); R = Vector3.new(oppAxis.X, y, mx.Z)
    else
        L = Vector3.new(mn.X, y, oppAxis.Z); R = Vector3.new(mx.X, y, oppAxis.Z)
    end
    local fwd = Vector3.new(center.X - myPos.X, 0, center.Z - myPos.Z)
    if fwd.Magnitude < 0.01 then fwd = Vector3.new(0,0,1) end
    fwd = fwd.Unit
    local rd = fwd:Cross(Vector3.new(0,1,0))
    if rd.Magnitude < 0.01 then rd = Vector3.new(1,0,0) end
    rd = rd.Unit
    local a = Vector3.new(L.X - myPos.X, 0, L.Z - myPos.Z)
    local b = Vector3.new(R.X - myPos.X, 0, R.Z - myPos.Z)
    if a:Dot(rd) > b:Dot(rd) then L, R = R, L end
    return { left=L, right=R, center=center, minV=mn, maxV=mx, longAxis=axis, mySign=mySign, parts=#parts }
end
local function isOnOuterCourt(pos)
    if #CourtData.OuterParts == 0 then return false end
    for _, p in ipairs(CourtData.OuterParts) do
        local lp = p.CFrame:PointToObjectSpace(pos)
        local h = p.Size * 0.5
        if math.abs(lp.X) <= h.X + 2 and math.abs(lp.Z) <= h.Z + 2 then return true end
    end
    return false
end
local function computeSafeTarget()
    if not CourtData.Valid then return nil end
    local mn, mx, center = CourtData.MinV, CourtData.MaxV, CourtData.Center
    local axis, mySign = CourtData.LongAxis, CourtData.MySign
    local oppSign = -mySign
    local y = center.Y
    local av = function(v) return (axis == "X") and v.X or v.Z end
    local oMin, oMax
    if oppSign == 1 then oMin = av(center); oMax = av(mx)
    else oMin = av(mn); oMax = av(center) end
    local enemies = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local same = LP.Team and plr.Team == LP.Team
            if not same then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    table.insert(enemies, hrp.Position)
                end
            end
        end
    end
    local best, bs = nil, -math.huge
    for i = 1, 5 do
        local ta = 0.25 + (i-1)/4 * 0.55
        for j = 1, 5 do
            local tb = 0.1 + (j-1)/4 * 0.8
            local aC = oMin + (oMax - oMin) * ta
            local p
            if axis == "X" then p = Vector3.new(aC, y, mn.Z + (mx.Z - mn.Z) * tb)
            else p = Vector3.new(mn.X + (mx.X - mn.X) * tb, y, aC) end
            if p.X >= mn.X and p.X <= mx.X and p.Z >= mn.Z and p.Z <= mx.Z then
                local score
                if #enemies == 0 then
                    score = -(Vector3.new(p.X,0,p.Z) - Vector3.new(center.X,0,center.Z)).Magnitude
                else
                    score = math.huge
                    for _, e in ipairs(enemies) do
                        local d = (Vector3.new(e.X,0,e.Z) - Vector3.new(p.X,0,p.Z)).Magnitude
                        if d < score then score = d end
                    end
                end
                if score > bs then bs = score; best = p end
            end
        end
    end
    return best
end
local function isPathBlocked(o, tp)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    local ig = {LP.Character, VFolder}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP or (LP.Team and plr.Team == LP.Team) then
            if plr.Character then table.insert(ig, plr.Character) end
        end
    end
    p.FilterDescendantsInstances = ig
    local r = Workspace:Raycast(o, tp - o, p)
    if r and r.Instance then
        local c = r.Instance:FindFirstAncestorOfClass("Model")
        if c and Players:GetPlayerFromCharacter(c) then return true end
    end
    return false
end

autoCheckCourt = function()
    local court = findCourt()
    if not court then return false, "ไม่พบ Court" end
    local res, err = computeTargets(court)
    if not res then return false, err end
    local outer = findOuterCourt()
    local outerParts = collectParts(outer)
    CourtData.Valid = true
    CourtData.Center = res.center
    CourtData.MinV = res.minV
    CourtData.MaxV = res.maxV
    CourtData.LeftTarget = res.left
    CourtData.RightTarget = res.right
    CourtData.OuterParts = outerParts
    CourtData.MySign = res.mySign
    CourtData.LongAxis = res.longAxis
    VLeft.Position = res.left; VRight.Position = res.right
    VLeft.Color = Color3.fromRGB(255,255,255)
    VRight.Color = Color3.fromRGB(255,255,255)
    VTarget.Position = Vector3.new(0,-500,0)
    return true
end

local function getFacingTarget()
    if not CourtData.Valid then return nil, false end
    local L, R = CourtData.LeftTarget, CourtData.RightTarget
    if not L or not R then return nil, false end
    local myChar = LP.Character
    local cam = getCam()
    local myPos = (myChar and myChar:FindFirstChild("HumanoidRootPart"))
        and myChar.HumanoidRootPart.Position or (cam and cam.CFrame.Position)
    if not myPos then return nil, false end
    local look = cam and cam.CFrame.LookVector or Vector3.new(0,0,-1)
    if Config.SmartLockEnabled and isOnOuterCourt(myPos) then
        local now = tick()
        if not SafeCache.pos or (now - SafeCache.time) > 0.15 then
            SafeCache.pos = computeSafeTarget() or SafeCache.pos
            SafeCache.time = now
        end
        if SafeCache.pos then
            VSafe.Position = SafeCache.pos
            return SafeCache.pos, true
        end
    else
        VSafe.Position = Vector3.new(0,-500,0)
    end
    local dL = look:Dot((L - myPos).Unit)
    local dR = look:Dot((R - myPos).Unit)
    local target = (dL >= dR) and L or R
    if Config.SmartLockEnabled then
        local lB = isPathBlocked(myPos, L)
        local rB = isPathBlocked(myPos, R)
        if lB and not rB then return R, false end
        if rB and not lB then return L, false end
    end
    return target, false
end

