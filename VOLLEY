local LocalizedLabels = {}
local function regLbl(l, k, baseSize)
    table.insert(LocalizedLabels, { lbl = l, key = k, baseSize = baseSize or l.TextSize })
    l.Text = t(k)
end
local function refreshLang()
    for _, e in ipairs(LocalizedLabels) do
        e.lbl.Text = t(e.key)
        if e.baseSize then
            e.lbl.TextSize = (LANG == "th") and (e.baseSize + TH_OFFSET) or e.baseSize
        end
    end
    Title.Text = t("title")
    SubTitle.Text = STR[LANG].sub
end

