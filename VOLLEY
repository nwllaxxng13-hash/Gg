    w.BorderSizePixel = 0; w.Parent = p
    Instance.new("UICorner", w).CornerRadius = UDim.new(0, 10)
    local ws = Instance.new("UIStroke", w)
    ws.Color = Color3.fromRGB(60,60,95); ws.Thickness = 1; ws.Transparency = 0.55

    local l = newLabel(w, UDim2.fromOffset(14, 6), UDim2.new(1,-90,0,20), t(labelKey), FONT_BODY, fs(13))
    regLbl(l, labelKey, fs(13))
    local v = newLabel(w, UDim2.new(1,-90,0,6), UDim2.fromOffset(76,20),
        string.format("%."..decimals.."f", init), FONT_BOLD, fs(14), Enum.TextXAlignment.Right)
    v.TextColor3 = Color3.fromRGB(255,215,130)

    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0.5,1); bar.Position = UDim2.new(0.5,0,1,-8)
    bar.Size = UDim2.new(0.9,0,0,8)
    bar.BackgroundColor3 = Color3.fromRGB(50,50,72)
    bar.BorderSizePixel = 0; bar.Parent = w
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0,0,1,0); fill.BackgroundColor3 = Themes[Config.Theme].base
    fill.BorderSizePixel = 0; fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    regAccent(fill, "BackgroundColor3")

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5,0.5); knob.Position = UDim2.fromScale(0,0.5)
    knob.Size = UDim2.fromOffset(16,16); knob.BackgroundColor3 = Color3.fromRGB(248,248,255)
    knob.BorderSizePixel = 0; knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    local kstroke = Instance.new("UIStroke", knob)
    kstroke.Color = Themes[Config.Theme].base; kstroke.Thickness = 2
    regAccent(kstroke, "Color")

    local val = init
    local function setF(f)
        f = math.clamp(f, 0, 1)
        val = mn + (mx - mn) * f
        fill.Size = UDim2.fromScale(f, 1)
        knob.Position = UDim2.fromScale(f, 0.5)
        v.Text = string.format("%."..decimals.."f", val)
        if cb then
            local ok, err = pcall(cb, val)
            if not ok then warn("[VL-UI] Slider error:", err) end
        end
    end
    setF((init - mn) / (mx - mn))

    local drag = false
    local function chg(i)
        if not drag then return end
        local ap = bar.AbsolutePosition
        local asz = bar.AbsoluteSize
        setF((i.Position.X - ap.X) / asz.X)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; chg(i)
            TS:Create(knob, TweenInfo.new(0.12, Enum.EasingStyle.Back), {
                Size = UDim2.fromOffset(22, 22)
            }):Play()
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    drag = false
                    TS:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Back), {
                        Size = UDim2.fromOffset(16, 16)
                    }):Play()
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then chg(i) end
    end)
    return { set = function(x) setF((x - mn) / (mx - mn)) end, get = function() return val end }
end

local function newDropdown(p, labelKey, opts, init, cb, layoutOrder, height)
    height = height or 44
    local w = Instance.new("Frame")
    w.Size = UDim2.new(1, 0, 0, height)
    w.LayoutOrder = layoutOrder or 0
    w.BackgroundColor3 = Color3.fromRGB(30, 30, 46)
    w.BackgroundTransparency = 0.25
    w.BorderSizePixel = 0; w.Parent = p
    Instance.new("UICorner", w).CornerRadius = UDim.new(0, 10)
    local ws = Instance.new("UIStroke", w)
    ws.Color = Color3.fromRGB(60,60,95); ws.Thickness = 1; ws.Transparency = 0.55

    local l = newLabel(w, UDim2.fromOffset(14, 0), UDim2.new(1,-140,1,0), t(labelKey), FONT_BODY, fs(13))
    regLbl(l, labelKey, fs(13))

    local function getDisplay(opt)
        if type(opt) == "table" then return opt.display or tostring(opt.value) end
        return tostring(opt)
    end
    local function getValue(opt)
        if type(opt) == "table" then return opt.value end
        return opt
    end

    local initDisplay = tostring(init)
    for _, opt in ipairs(opts) do
        if getValue(opt) == init then initDisplay = getDisplay(opt); break end
    end

    local sel = Instance.new("TextButton")
    sel.AnchorPoint = Vector2.new(1,0.5); sel.Position = UDim2.new(1,-10,0.5,0)
    sel.Size = UDim2.fromOffset(130,28)
    sel.BackgroundColor3 = Color3.fromRGB(44,44,64)
    sel.TextColor3 = Color3.fromRGB(245,245,255)
    sel.Font = FONT_TITLE; sel.TextSize = fs(13)
    sel.Text = initDisplay; sel.BorderSizePixel = 0; sel.Parent = w
    Instance.new("UICorner", sel).CornerRadius = UDim.new(0,8)
    local selStroke = Instance.new("UIStroke", sel)
    selStroke.Color = Color3.fromRGB(75,75,110); selStroke.Thickness = 1; selStroke.Transparency = 0.4

    sel.MouseEnter:Connect(function()
        TS:Create(sel, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(65,65,90) }):Play()
    end)
    sel.MouseLeave:Connect(function()
        TS:Create(sel, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(44,44,64) }):Play()
    end)

    local list
    local function closeList()
        if not list then return end
        local ll = list; list = nil
        TS:Create(ll, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(130, 0), BackgroundTransparency = 1
        }):Play()
        task.delay(0.2, function() ll:Destroy() end)
    end
    local function openList()
        if list then closeList(); return end
        list = Instance.new("Frame")
        list.Position = UDim2.new(1,-140,1,4)
        list.Size = UDim2.fromOffset(130, 0)
        list.BackgroundColor3 = Color3.fromRGB(16,16,26)
        list.BorderSizePixel = 0; list.ZIndex = 20; list.Parent = w
        Instance.new("UICorner", list).CornerRadius = UDim.new(0,10)
        local st = Instance.new("UIStroke", list)
        st.Color = Themes[Config.Theme].base; st.Thickness = 1.3; st.Transparency = 0.3
        TS:Create(list, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(130, #opts * 26 + 8)
        }):Play()
        for i, o in ipairs(opts) do
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1,-8,0,24)
            ob.Position = UDim2.fromOffset(4, 4 + (i-1) * 26)
            ob.BackgroundColor3 = Color3.fromRGB(28,28,44)
            ob.BackgroundTransparency = 0.4
            ob.TextColor3 = Color3.fromRGB(235,235,245)
            ob.Font = FONT_BODY; ob.TextSize = fs(13)
            ob.Text = getDisplay(o); ob.BorderSizePixel = 0; ob.ZIndex = 21; ob.Parent = list
            Instance.new("UICorner", ob).CornerRadius = UDim.new(0,7)
            ob.MouseEnter:Connect(function()
                TS:Create(ob, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play()
            end)
            ob.MouseLeave:Connect(function()
                TS:Create(ob, TweenInfo.new(0.12), { BackgroundTransparency = 0.4 }):Play()
            end)
            ob.MouseButton1Click:Connect(function()
                sel.Text = getDisplay(o); closeList()
                if cb then
                    local ok, err = pcall(cb, getValue(o))
                    if not ok then warn("[VL-UI] Dropdown error:", err) end
                end
            end)
        end
    end
    sel.MouseButton1Click:Connect(openList)
    return {
        set = function(v)
            for _, opt in ipairs(opts) do
                if getValue(opt) == v then sel.Text = getDisplay(opt); return end
            end
            sel.Text = tostring(v)
        end,
        get = function() return sel.Text end,
    }
end

