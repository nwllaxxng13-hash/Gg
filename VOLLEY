local function mkVis(n, c)
    local p = VFolder:FindFirstChild(n)
    if not p then
        p = Instance.new("Part")
        p.Name = n; p.Shape = Enum.PartType.Ball; p.Size = Vector3.new(3,3,3)
        p.Material = Enum.Material.Neon; p.Anchored = true
        p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
        p.Transparency = 0.2; p.Parent = VFolder
    end
    p.Color = c
    p.Position = Vector3.new(0, -500, 0)
    return p
end
