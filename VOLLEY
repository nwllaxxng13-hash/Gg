-- เส้น (Lines Tab) - FIXED dynamic creation & tracking
-- ═══════════════════════════════════════════════════════════
local LinesTab = Window:Tab({
    Title = "เส้นมุมมอง",
    Icon = "solar:eye-bold",
    IconColor = Color3.fromRGB(255, 200, 0),
    Border = true,
})

local lineDistance = 50
local lines = {}
local linesEnabled = true
local lineColors = {
    Color3.fromRGB(255, 0, 0),
    Color3.fromRGB(0, 255, 0),
    Color3.fromRGB(0, 0, 255),
    Color3.fromRGB(255, 165, 0),
    Color3.fromRGB(128, 0, 128),
    Color3.fromRGB(255, 255, 0),
    Color3.fromRGB(139, 0, 0),
    Color3.fromRGB(0, 100, 0)
}

local function removeLine(player)
    if lines[player] then
        local data = lines[player]
        if data.beam then data.beam:Destroy() end
        if data.targetAttachment then data.targetAttachment:Destroy() end
        if data.headAttachment then data.headAttachment:Destroy() end
        if data.targetPart then data.targetPart:Destroy() end
        lines[player] = nil
    end
end

local function createLine(player, colorIndex)
    removeLine(player)
    
    local character = player.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    local headAttachment = Instance.new("Attachment")
    headAttachment.Name = "LineESPHeadAttachment"
    headAttachment.Parent = head

    local targetPart = Instance.new("Part")
    targetPart.Name = "LineESPTarget"
    targetPart.Anchored = true
    targetPart.CanCollide = false
    targetPart.Transparency = 1
    targetPart.Size = Vector3.new(0.05, 0.05, 0.05)
    targetPart.Parent = Workspace

    local targetAttachment = Instance.new("Attachment")
    targetAttachment.Parent = targetPart

    local beam = Instance.new("Beam")
    beam.Attachment0 = headAttachment
    beam.Attachment1 = targetAttachment
    beam.Width0 = 0.25
    beam.Width1 = 0.25
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.Transparency = NumberSequence.new(0.3)
    beam.Color = ColorSequence.new(lineColors[(colorIndex - 1) % #lineColors + 1])
    beam.Parent = head

    lines[player] = {
        beam = beam,
        headAttachment = headAttachment,
        targetAttachment = targetAttachment,
        targetPart = targetPart
    }
end

RunService.Heartbeat:Connect(function()
    if not linesEnabled then
        for player in pairs(lines) do
            removeLine(player)
        end
        return
    end

    local currentPlayers = Players:GetPlayers()
    for index, player in ipairs(currentPlayers) do
        if player ~= LocalPlayer and (not LocalPlayer.Team or player.Team ~= LocalPlayer.Team) then
            local character = player.Character
            if character and character:FindFirstChild("Head") and character:FindFirstChild("HumanoidRootPart") then
                if not lines[player] or not lines[player].headAttachment.Parent then
                    createLine(player, index)
                end
                
                local data = lines[player]
                if data and data.targetPart then
                    local head = character.Head
                    local rootPart = character.HumanoidRootPart
                    data.targetPart.Position = head.Position + (rootPart.CFrame.LookVector * lineDistance)
                end
            else
                removeLine(player)
            end
        else
            removeLine(player)
        end
    end
end)

Players.PlayerRemoving:Connect(removeLine)

LinesTab:Toggle({
    Title = "เปิดเส้นมุมมอง",
    Value = true,
    Callback = function(value)
        linesEnabled = value
        if not value then
            for player in pairs(lines) do
                removeLine(player)
            end
        end
    end,
})

LinesTab:Space()

LinesTab:Slider({
    Title = "ระยะเส้น",
    Step = 5,
    Value = {
        Min = 10,
        Max = 200,
        Default = 50,
    },
    Callback = function(value)
        lineDistance = value
    end,
})

