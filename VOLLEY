            if Config.EspEnabled and isEnemyOfMe(plr) then
                buildEspFor(plr)
            end
        end)
    end
end
Players.PlayerRemoving:Connect(removeEspFor)

-- ============================================================
-- Main loop
-- ============================================================
RS.RenderStepped:Connect(function()
    if Config.EspEnabled then
        for plr, e in pairs(EspLines) do
            if not e.head or not e.head.Parent or not e.root or not e.root.Parent then
                removeEspFor(plr)
            else
                e.targetPart.Position = e.head.Position + (e.root.CFrame.LookVector * Config.EspDistance)
            end
        end
    end

    if not CourtData.Valid then return end
    local target, safeMode = getFacingTarget()
    if target then
        VTarget.Position = target
        if safeMode then
            VTarget.Color = Color3.fromRGB(0,200,255)
            VLeft.Color = Color3.fromRGB(255,255,255)
            VRight.Color = Color3.fromRGB(255,255,255)
        elseif target == CourtData.LeftTarget then
            VTarget.Color = Color3.fromRGB(255,0,0)
            VLeft.Color = Color3.fromRGB(255,0,0)
            VRight.Color = Color3.fromRGB(255,255,255)
        else
            VTarget.Color = Color3.fromRGB(255,0,0)
            VLeft.Color = Color3.fromRGB(255,255,255)
            VRight.Color = Color3.fromRGB(255,0,0)
        end
    end
    if not Config.AutoCornerEnabled or not target then return end
    local ch = LP.Character; if not ch then return end
    local root = ch:FindFirstChild("HumanoidRootPart")
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local st = hum:GetState()
    local jumping = (st == Enum.HumanoidStateType.Jumping)
        or (st == Enum.HumanoidStateType.Freefall)
        or (root.AssemblyLinearVelocity.Y > 0.5)
    if jumping then
        root.CFrame = CFrame.new(root.Position, Vector3.new(target.X, root.Position.Y, target.Z))
    end
end)

local function refreshScale()
    local s = autoScale()
    if MainScale then MainScale.Scale = s end
    if NotifyScale then NotifyScale.Scale = s end
    if MiniScale then MiniScale.Scale = s end
end
task.spawn(function()
    local cam = getCam()
    while task.wait(1) do
        local c = getCam()
        if c and c ~= cam then cam = c; refreshScale() end
    end
end)
