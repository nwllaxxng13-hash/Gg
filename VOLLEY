    track.AnchorPoint = Vector2.new(1,0.5)
    track.Position = UDim2.new(1,-10,0.5,0)
    track.Size = UDim2.fromOffset(48,24)
    track.BackgroundColor3 = Color3.fromRGB(55,55,78)
    track.BorderSizePixel = 0; track.ZIndex = 2; track.Parent = w
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5,0.5); knob.Position = UDim2.fromScale(0.26,0.5)
    knob.Size = UDim2.fromOffset(20,20)
    knob.BackgroundColor3 = Color3.fromRGB(245,245,255)
    knob.BorderSizePixel = 0; knob.ZIndex = 2; knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

    local st = initial
    local function refr(anim, pulse)
        local ti = anim and TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            or TweenInfo.new(0)
        TS:Create(knob, ti, { Position = st and UDim2.fromScale(0.74,0.5) or UDim2.fromScale(0.26,0.5) }):Play()
        local c = st and Themes[Config.Theme].base or Color3.fromRGB(55,55,78)
        TS:Create(track, TweenInfo.new(0.2), { BackgroundColor3 = c }):Play()

        if pulse then
            glow.BackgroundTransparency = 0.7
            local t2 = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TS:Create(glow, t2, { BackgroundTransparency = 1 }):Play()
            TS:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
                Size = UDim2.fromOffset(24, 24)
            }):Play()
            task.delay(0.15, function()
                TS:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
                    Size = UDim2.fromOffset(20, 20)
                }):Play()
            end)
        end
    end
    refr(false, false)

    local btn = Instance.new("TextButton")
    btn.BackgroundTransparency = 1; btn.Size = UDim2.fromScale(1,1); btn.Text = ""
    btn.ZIndex = 5; btn.Parent = w
    btn.MouseButton1Click:Connect(function()
        st = not st; refr(true, true)
        if cb then
            local ok, err = pcall(cb, st)
            if not ok then warn("[VL-UI] Toggle error:", err) end
        end
    end)
    regAccent(track, "BackgroundColor3")
    return { set = function(v) st = v; refr(false, false) end, get = function() return st end }
end

local function newSlider(p, labelKey, mn, mx, init, cb, layoutOrder, height, decimals)
    height = height or 58
