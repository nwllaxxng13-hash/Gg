-- ============================================================
local EspFolder = Workspace:FindFirstChild("VL_EspLines") or Instance.new("Folder")
EspFolder.Name = "VL_EspLines"; EspFolder.Parent = Workspace
local EspLines = {}

local function isEnemyOfMe(plr)
    if plr == LP then return false end
    if LP.Team and plr.Team == LP.Team then return false end
    return true
end

local function removeEspFor(plr)
    local e = EspLines[plr]; if not e then return end
    if e.beam then e.beam:Destroy() end
    if e.attachA then e.attachA:Destroy() end
    if e.attachB then e.attachB:Destroy() end
    if e.targetPart then e.targetPart:Destroy() end
    EspLines[plr] = nil
end

local function buildEspFor(plr)
    if not isEnemyOfMe(plr) then return end
    local ch = plr.Character; if not ch then return end
    local head = ch:FindFirstChild("Head")
    local root = ch:FindFirstChild("HumanoidRootPart")
    if not head or not root then return end

    removeEspFor(plr)  -- clean before build

    local aA = Instance.new("Attachment", head); aA.Name = "VL_EspA"
    local tp = Instance.new("Part")
    tp.Name = "VL_EspTarget"; tp.Size = Vector3.new(0.05,0.05,0.05)
    tp.Anchored = true; tp.CanCollide = false
    tp.CanQuery = false; tp.CanTouch = false; tp.Transparency = 1
    tp.Parent = EspFolder
    local aB = Instance.new("Attachment", tp); aB.Name = "VL_EspB"
    local beam = Instance.new("Beam")
    beam.Attachment0 = aA; beam.Attachment1 = aB
    beam.Width0 = 0.25; beam.Width1 = 0.25
    beam.FaceCamera = true; beam.LightEmission = 1
    beam.Transparency = NumberSequence.new(0.3)
    beam.Color = ColorSequence.new(Color3.fromHSV((plr.UserId % 100) / 100, 0.7, 1))
    beam.Parent = tp
    EspLines[plr] = { beam=beam, attachA=aA, attachB=aB, targetPart=tp, head=head, root=root }
end

startEsp = function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemyOfMe(plr) then
            buildEspFor(plr)
        end
    end
end

stopEsp = function()
    for plr in pairs(EspLines) do removeEspFor(plr) end
end

-- Sync loop: keep lines only for current enemies with valid characters
task.spawn(function()
    while task.wait(0.4) do
        if not Config.EspEnabled then continue end

        -- build lines for any enemy missing
        for _, plr in ipairs(Players:GetPlayers()) do
            if isEnemyOfMe(plr) then
                local ch = plr.Character
                if ch and ch:FindFirstChild("Head") and ch:FindFirstChild("HumanoidRootPart") then
                    local e = EspLines[plr]
                    local needRebuild = (not e)
                        or (not e.head or not e.head.Parent)
                        or (e.head.Parent ~= ch.Head)  -- respawned = head replaced
                    if needRebuild then
                        buildEspFor(plr)
                    end
                else
                    if EspLines[plr] then removeEspFor(plr) end
                end
            else
                -- not enemy anymore -> remove
                if EspLines[plr] then removeEspFor(plr) end
            end
        end

        -- remove lines for players who left
        for plr in pairs(EspLines) do
            if not plr.Parent then
                removeEspFor(plr)
            end
        end
    end
end)

