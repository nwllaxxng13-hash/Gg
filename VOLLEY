local TabButtons, TabFrames = {}, {}
local ActiveTab = "corner"

local function applyAccentColorToTabs()
    for n, b in pairs(TabButtons) do
        local on = (n == ActiveTab)
        local color = on and Themes[Config.Theme].base or Color3.fromRGB(28,28,42)
        TS:Create(b, TweenInfo.new(0.2), { BackgroundColor3 = color }):Play()
    end
end

local function switchTab(name)
    ActiveTab = name
    for n, f in pairs(TabFrames) do f.Visible = (n == name) end
    applyAccentColorToTabs()
end

local function makeTab(key, ord)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-14,0,38)
    b.Position = UDim2.fromOffset(7, 8 + (ord-1)*44)
    b.BackgroundColor3 = Color3.fromRGB(28,28,42)
    b.TextColor3 = Color3.fromRGB(210,210,230)
    b.Font = FONT_TITLE; b.TextSize = fs(13)
    b.Text = "   " .. t(key)
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.BorderSizePixel = 0; b.Parent = Sidebar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,10)
    b.MouseButton1Click:Connect(function() switchTab(key) end)
    b.MouseEnter:Connect(function()
        if ActiveTab ~= key then
            TS:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(45,45,68) }):Play()
        end
    end)
    b.MouseLeave:Connect(function()
        if ActiveTab ~= key then
            TS:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(28,28,42) }):Play()
        end
    end)
    TabButtons[key] = b

    -- ⚠️ ScrollingFrame per tab
    local f = Instance.new("ScrollingFrame")
    f.Size = UDim2.fromScale(1, 1)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.ScrollBarThickness = 4
    f.ScrollBarImageColor3 = Themes[Config.Theme].base
    f.ScrollBarImageTransparency = 0.3
    f.CanvasSize = UDim2.new(0, 0, 0, 0)
    f.AutomaticCanvasSize = Enum.AutomaticSize.Y
    f.ScrollingDirection = Enum.ScrollingDirection.Y
    f.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
    f.Visible = false
    f.Parent = Content
    regAccent(f, "ScrollBarImageColor3")

    local flay = Instance.new("UIListLayout", f)
    flay.Padding = UDim.new(0, 10)
    flay.SortOrder = Enum.SortOrder.LayoutOrder
    flay.FillDirection = Enum.FillDirection.Vertical

    local fpad = Instance.new("UIPadding", f)
    fpad.PaddingTop = UDim.new(0, 4)
    fpad.PaddingBottom = UDim.new(0, 12)
    fpad.PaddingRight = UDim.new(0, 6)

    TabFrames[key] = f
    return f
end

