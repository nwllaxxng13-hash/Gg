    -- Visual Dome
    local function updateDomeVisual()
        if autoGkEnabled or autoGkV2Enabled or autoGkV3Enabled or autoGkV4Enabled or stealModeEnabled then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not domePart or not domePart.Parent then
                    domePart = Instance.new("Part")
                    domePart.Name = "AutoGK_DomeVisual"
                    domePart.Shape = Enum.PartType.Ball
                    domePart.Material = Enum.Material.ForceField
                    domePart.Color = THEME.ACCENT
                    domePart.Transparency = 0.5
                    domePart.CanCollide = false
                    domePart.Anchored = true
                    domePart.Massless = true
                    domePart.CastShadow = false
                    domePart.Parent = Workspace
                end
                domePart.Size = Vector3.new(autoGkRange * 2, autoGkRange * 2, autoGkRange * 2)
                domePart.CFrame = hrp.CFrame
            end
        else
            if domePart then
                domePart:Destroy()
                domePart = nil
            end
        end
    end

    local function setCharacterRagdoll(char, state)
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end

        if state then
            hum:ChangeState(Enum.HumanoidStateType.Physics)
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("Motor6D") and v.Part0 and v.Part1 and v.Name ~= "RootJoint" then
                    local p0, p1 = v.Part0, v.Part1
                    local att0 = p0:FindFirstChild(v.Name .. "RagdollAtt0") or Instance.new("Attachment")
                    att0.Name = v.Name .. "RagdollAtt0"
                    att0.CFrame = v.C0
                    att0.Parent = p0
                    local att1 = p1:FindFirstChild(v.Name .. "RagdollAtt1") or Instance.new("Attachment")
                    att1.Name = v.Name .. "RagdollAtt1"
                    att1.CFrame = v.C1
                    att1.Parent = p1
                    local bs = p0:FindFirstChild(v.Name .. "RagdollConstraint") or Instance.new("BallSocketConstraint")
                    bs.Name = v.Name .. "RagdollConstraint"
                    bs.Attachment0 = att0
                    bs.Attachment1 = att1
                    bs.LimitsEnabled = true
                    bs.TwistLimitsEnabled = true
                    bs.UpperAngle = 45
                    bs.TwistLowerAngle = -45
                    bs.TwistUpperAngle = 45
                    bs.Parent = p0
                    v.Enabled = false
                elseif v:IsA("BasePart") and v ~= hrp then
                    v.CanCollide = true
                end
            end
            hrp.CanCollide = false
        else
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BallSocketConstraint") and v.Name:find("RagdollConstraint") then
                    v:Destroy()
                elseif v:IsA("Attachment") and v.Name:find("RagdollAtt") then
                    v:Destroy()
                elseif v:IsA("Motor6D") then
                    v.Enabled = true
                elseif v:IsA("BasePart") then
                    if v.Name == "HumanoidRootPart" then
                        v.CanCollide = false
                    else
                        v.CanCollide = true
                    end
                    v.AssemblyLinearVelocity = Vector3.zero
                    v.AssemblyAngularVelocity = Vector3.zero
                end
            end
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.defer(function()
                if hum and hum.Parent then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
