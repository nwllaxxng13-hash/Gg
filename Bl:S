    -- ShidouDoubleJump
    local function doShidouDoubleJump()
        pcall(function()
            local p4 = LocalPlayer
            local char = p4.Character or p4.CharacterAdded:Wait()
            local humanoid = char:WaitForChild("Humanoid")
            local rootPart = char:WaitForChild("HumanoidRootPart")

            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
            task.wait(0.02)
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

            if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("UI") then
                ReplicatedStorage.Events.UI.CooldownBind:Fire("Double Jump", 4)
            end

            local anims = ReplicatedStorage:FindFirstChild("Anims") and ReplicatedStorage.Anims.Shidou.DoubleJumps:GetChildren()
            local animTrack = nil
            if anims and #anims > 0 then
                local randomAnim = anims[math.random(1, #anims)]
                animTrack = humanoid.Animator:LoadAnimation(randomAnim)
                animTrack:Play()
            end

            if ReplicatedStorage:FindFirstChild("Events") then
                ReplicatedStorage.Events.RandomGeneralEvent:FireServer("ShidouDoubleJump")
                ReplicatedStorage.Events.GeneralEffectBind:Fire("ShidouDoubleJump", {["Character"] = char})
                ReplicatedStorage.Events.DashSeqBindable:Fire("ShidouDoubleJump")
            end

            char:SetAttribute("Stunned", true)
            char:SetAttribute("CurrentlyShidouDoubleJumping", true)
            char:SetAttribute("CantHeader", true)

            local MuchachoHitbox = require(ReplicatedStorage.Modules.MuchachoHitbox)
            local hitbox = MuchachoHitbox.CreateHitbox()
            hitbox.CFrame = rootPart
            hitbox.Size = Vector3.new(13, 13, 13)
            hitbox.DetectionMode = "HitParts"
            hitbox.Visualizer = false

            local hitBall = false

            hitbox.Touched:Connect(function(part)
                if part.Name == "Ball" and part:FindFirstChild("WeldBall") then
                    local success = ReplicatedStorage.Events.ShidouDJumpHitBall:InvokeServer(part)
                    if success == true then
                        hitBall = true
                        hitbox:Stop()
                        if animTrack then animTrack:Stop() end
                    end
                end
            end)

            hitbox:Start()

            task.delay(0.8, function()
                hitbox:Stop()
                if hitBall == false then
                    char:SetAttribute("Stunned", false)
                end
            end)

            task.delay(1, function()
                char:SetAttribute("CurrentlyShidouDoubleJumping", nil)
                char:SetAttribute("CantHeader", nil)
            end)
        end)
    end

    -- FIX 2: ปรับแต่งการตรวจสอบความสูงของบอล
    -- Low = ขาลงไป (<= legY)
    -- High = ลำตัวขึ้นไป (>= torsoY)
    local function getBallHeightType(ball, char)
        local legY = nil
        local torsoY = nil

        local legParts = {}
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and (part.Name:lower():find("leg") or part.Name:lower():find("foot")) then
                table.insert(legParts, part)
            end
        end
        if #legParts == 0 then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then legY = hrp.Position.Y - 2 end
        else
            legY = legParts[1].Position.Y
            for _, p in ipairs(legParts) do
                if p.Position.Y < legY then legY = p.Position.Y end
            end
        end

        local torsoPart = nil
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name:lower():find("torso") then
                torsoPart = part
                break
            end
        end
        if torsoPart then
            torsoY = torsoPart.Position.Y
        else
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then torsoY = hrp.Position.Y + 1 end
        end

        if not legY or not torsoY then
            return "low"
        end

        local ballY = ball.Position.Y
        
        -- ตรวจสอบเงื่อนไขตาม Leg / Torso
        if ballY <= legY then
            return "low"
        elseif ballY >= torsoY then
            return "high"
        else
            -- กรณีอยู่ระหว่างกึ่งกลางขาและลำตัว
            local mid = (legY + torsoY) / 2
            if ballY <= mid then
                return "low"
            else
                return "high"
            end
        end
    end

    local function performAutoGkAction(mode)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hrp then return end

        updateDomeVisual()

        if autoRagdollEnabled and not isRagdolling and char:FindFirstChild("Ball") then
            triggerRagdollSequence(char)
        end

        if mode == 1 then
            -- V1
            for _, pChar in ipairs(Workspace:GetChildren()) do
                if pChar:IsA("Model") and pChar ~= char then
                    local pHrp = pChar:FindFirstChild("HumanoidRootPart")
                    if pHrp and (pHrp.Position - hrp.Position).Magnitude <= autoGkRange then
                        local playerBall = pChar:FindFirstChild("Ball")
                        if playerBall then
                            local weldBall = playerBall:FindFirstChild("WeldBall") or playerBall:FindFirstChildWhichIsA("RemoteEvent", true)
                            fireBurstRemotes(nil, weldBall, nil, 20)
                        end
                    end
                end
            end

            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj.Name == "Ball" and obj:IsA("BasePart") then
                    local now = os.clock()
                    local dt = math.max(now - lastCheckTime, 0.001)
                    local ballPos = obj.Position
                    local ballVel = obj.AssemblyLinearVelocity
                    if ballVel.Magnitude < 1 and lastBallPos then
                        ballVel = (ballPos - lastBallPos) / dt
                    end
                    lastBallPos = ballPos
                    lastCheckTime = now

                    local currentDist = (ballPos - hrp.Position).Magnitude
                    local predictedPos = ballPos + (ballVel * 0.15) + (0.5 * obj.AssemblyAngularVelocity * dt)
                    local predictedDist = (predictedPos - hrp.Position).Magnitude

                    if currentDist <= autoGkRange or predictedDist <= (autoGkRange * 1.25) then
                        local gkEvents = ReplicatedStorage:FindFirstChild("Events")
                        local gkDive = gkEvents and gkEvents:FindFirstChild("GKDive")
                        local weldBall = obj:FindFirstChild("WeldBall") or obj:FindFirstChildWhichIsA("RemoteEvent", true)

                        local localLookPos = hrp.CFrame:PointToObjectSpace(ballPos)
                        local targetDir = "Forward"
                        if math.abs(localLookPos.X) <= 3.8 or localLookPos.Y > 1.5 then
                            targetDir = "Forward"
                        elseif localLookPos.X < -3.8 then
                            targetDir = "Left"
                        else
                            targetDir = "Right"
                        end

                        fireBurstRemotes(gkDive, weldBall, targetDir, currentDist <= 12 and 25 or 12)
                    end
                end
            end
        elseif mode == 2 then
            -- V2
            local ball = Workspace:FindFirstChild("Ball")
            
            local isOwnedByUs = char:FindFirstChild("Ball") or (ball and ball:IsDescendantOf(char))
            
            if isOwnedByUs then
                setAutoGkV2State(false)
                if setMainAutoGkV2ToggleUI then setMainAutoGkV2ToggleUI(false) end
                v2State = "idle"
                v2FiredThisRound = false
                v2JumpedThisRound = false
                return
            end

            if not ball or not ball:IsA("BasePart") then
                v2State = "idle"
                v2FiredThisRound = false
                v2JumpedThisRound = false
                return
            end

            local ballPos = ball.Position
            local ballVel = ball.AssemblyLinearVelocity
            local dist = (ballPos - hrp.Position).Magnitude
            
            local fastPredictedPos = ballPos + (ballVel * 0.12)
            local fastPredictedDist = (fastPredictedPos - hrp.Position).Magnitude

            if dist <= autoGkRange or fastPredictedDist <= autoGkRange then
                if not v2FiredThisRound then
                    v2FiredThisRound = true
                    
                    if not v2JumpedThisRound then
                        v2JumpedThisRound = true
                        task.spawn(doShidouDoubleJump)
                    end

                    task.spawn(function()
                        local remote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("ShidouDJumpHitBall")
                        if remote then
                            pcall(function() remote:InvokeServer(ball) end)
                        end
                    end)
                end
            else
                if v2State ~= "idle" then
                    v2State = "idle"
                    v2FiredThisRound = false
                    v2JumpedThisRound = false
                end
            end
        elseif mode == 4 then
            -- FIX 2: V4 Adaptive (Low = V1, High = V2)
            local ball = Workspace:FindFirstChild("Ball")
            if ball and ball:IsA("BasePart") then
                local heightType = getBallHeightType(ball, char)
                if heightType == "low" then
                    return performAutoGkAction(1) -- Low = V1
                else
                    return performAutoGkAction(2) -- High = V2
                end
            end
        end
    end

