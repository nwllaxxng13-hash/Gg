    local function setupIconDragging(iconInstance)
        local iconDrag, iconStartPos, iconDragStart
        iconInstance.InputBegan:Connect(function(input)
            if isIconLocked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                iconDrag = true
                iconDragStart = input.Position
                iconStartPos = iconInstance.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if isIconLocked then return end
            if iconDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - iconDragStart
                iconInstance.Position = UDim2.new(iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X, iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                iconDrag = false
            end
        end)
    end

