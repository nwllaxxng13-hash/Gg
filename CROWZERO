-- Mobile-Friendly Dragging Logic
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

Title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

-- Aura Logic
local auraEnabled = false
local hitRange = 15
local domePart = nil

local function updateDome()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    if not domePart or not domePart.Parent then
        domePart = Instance.new("Part")
        domePart.Shape = Enum.PartType.Ball
        domePart.Material = Enum.Material.ForceField
        domePart.Color = Color3.fromRGB(255, 0, 0)
        domePart.Transparency = 0.6
        domePart.CanCollide = false
        domePart.Anchored = false
        domePart.Massless = true
        domePart.Parent = char

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = char.HumanoidRootPart
        weld.Part1 = domePart
        weld.Parent = domePart
        domePart.Position = char.HumanoidRootPart.Position
    end
    domePart.Size = Vector3.new(hitRange * 2, hitRange * 2, hitRange * 2)
end

RangeInput.FocusLost:Connect(function()
    local newRange = tonumber(RangeInput.Text)
    if newRange then
        hitRange = newRange
        if auraEnabled then updateDome() end
    else
        RangeInput.Text = tostring(hitRange)
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
    auraEnabled = not auraEnabled
    if auraEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        ToggleButton.Text = "Aura: ON"
        updateDome()
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ToggleButton.Text = "Aura: OFF"
        if domePart then
            domePart:Destroy()
            domePart = nil
        end
    end
end)

