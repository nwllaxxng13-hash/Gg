-- Auto Switch Weapon Logic (0.5s Delay)
local autoSwitchEnabled = false

AutoSwitchButton.MouseButton1Click:Connect(function()
    autoSwitchEnabled = not autoSwitchEnabled
    if autoSwitchEnabled then
        AutoSwitchButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        AutoSwitchButton.Text = "Auto Switch: ON"
    else
        AutoSwitchButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        AutoSwitchButton.Text = "Auto Switch: OFF"
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if autoSwitchEnabled then
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            local char = LocalPlayer.Character
            
            if backpack and char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local tools = backpack:GetChildren()
                
                if humanoid and #tools > 0 then
                    for _, tool in ipairs(tools) do
                        if not autoSwitchEnabled then break end
                        if tool:IsA("Tool") then
                            humanoid:EquipTool(tool)
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
    end
end)

-- Lowest HP Target Fire Logic
local FIRE_DELAY = 0.1
local lastFire = 0

RunService.Heartbeat:Connect(function()
    if not auraEnabled then return end
    
    local now = tick()
    if now - lastFire < FIRE_DELAY then return end
    lastFire = now

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    -- Anti-Seat enforcement on heartbeat
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit then
        hum.Sit = false
    end
    
    if not domePart or not domePart.Parent then updateDome() end

    local myPos = char.HumanoidRootPart.Position
    local maxDistanceSq = hitRange * hitRange
    
    local damageEvent = ReplicatedStorage:FindFirstChild("DealDamageEvent")
    local bottleHitEvent = ReplicatedStorage:FindFirstChild("BottleHitEvent")

    local lowestTarget = nil
    local lowestHealth = math.huge

    -- Search for lowest HP enemy in range
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team ~= LocalPlayer.Team then
            local enemyChar = player.Character
            if enemyChar then
                local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
                local enemyHum = enemyChar:FindFirstChild("Humanoid")
                
                if enemyRoot and enemyHum and enemyHum.Health > 0 then
                    local distSq = (enemyRoot.Position - myPos).Magnitude ^ 2
                    if distSq <= maxDistanceSq then
                        if enemyHum.Health < lowestHealth then
                            lowestHealth = enemyHum.Health
                            lowestTarget = enemyChar
                        end
                    end
                end
            end
        end
    end

    -- Fire remotes at the lowest HP target
    if lowestTarget then
        if damageEvent then
            damageEvent:FireServer(lowestTarget)
        end
        if bottleHitEvent then
            bottleHitEvent:FireServer(lowestTarget)
        end
    end
end)
